<form class="footlights-reset-settings">
  <p>
    This will reset all saved Footlights data and settings for this world, including scenes,
    avatars, sounds, maps, portals, themes, Stage Goblin bars, planner data, and runtime state.
  </p>
  <p>
    This cannot be undone from inside Footlights. Type <strong>DELETE</strong> to confirm.
  </p>
  <div class="form-group">
    <label>Confirmation</label>
    <input type="text" name="confirmation" autocomplete="off" placeholder="DELETE">
  </div>
  <p class="footlights-reset-settings__feedback"></p>
  <footer class="sheet-footer flexrow">
    <button type="submit" class="danger">
      <i class="fas fa-trash-alt"></i>
      Reset Footlights
    </button>
    <button type="button" data-action="close">
      <i class="fas fa-times"></i>
      Cancel
    </button>
  </footer>
</form>
