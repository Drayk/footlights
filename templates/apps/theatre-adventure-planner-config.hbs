<form class="tom-theme-root tom-theme-default" style="{{themeInlineStyle}}">
  <section class="tom-theme-content-surface">
    <div class="form-group">
      <label for="planner-name">{{tr "Name"}}</label>
      <input id="planner-name" type="text" name="name" value="{{planner.name}}" />
    </div>
  </section>

  <footer class="sheet-footer flexrow">
    <button type="submit" class="tom-button tom-button-primary">{{tr "Save"}}</button>
  </footer>
</form>
