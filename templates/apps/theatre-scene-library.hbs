                  <button type="button" data-action="add-stage-goblin-entry" data-stage-goblin-type="theatreScene" data-stage-goblin-id="{{id}}" data-stage-goblin-label="{{name}}" class="tom-scene-library-action tom-scene-library-action--icon" title="{{tr "Add to StageGoblin"}}" aria-label="{{tr "Add to StageGoblin"}}">
                    <i class="fas fa-hat-wizard" aria-hidden="true"></i>
                  </button>
                  <button type="button" data-action="create-scene-macro" data-scene-id="{{id}}" class="tom-scene-library-action tom-scene-library-action--icon" title="{{tr "Create macro"}}" aria-label="{{tr "Create macro"}}">
                    <i class="fas fa-bolt" aria-hidden="true"></i>
                  </button>
                  <button type="button" data-action="duplicate-scene" data-scene-id="{{id}}" class="tom-scene-library-action tom-scene-library-action--icon" title="{{tr "Duplicate scene"}}" aria-label="{{tr "Duplicate scene"}}">
                    <i class="fas fa-clone" aria-hidden="true"></i>
                  </button>
                </div>
              </div>
            </article>
            {{else}}
              <article class="tom-scene-library-item tom-theme-card {{#if isActive}}is-active{{/if}}" draggable="true" data-drag-theatre-scene="true" data-scene-id="{{id}}" data-library-search-tab="scenes" data-library-search-text="{{name}} {{stageTitle}} {{stageSubtitle}} {{description}} {{location}} {{tags}}">
                <div class="tom-scene-library-item__preview">
                {{#if thumbnail}}
                <img src="{{thumbnail}}" alt="{{name}}" class="tom-scene-library-item__thumbnail" />
                {{else if isVideoThumbnailFallback}}
                <div class="tom-scene-library-item__placeholder" aria-hidden="true">
                  <i class="fas fa-film" aria-hidden="true"></i>
                </div>
                {{else}}
                <div class="tom-scene-library-item__placeholder" aria-hidden="true">
                  <i class="fas fa-film" aria-hidden="true"></i>
                </div>
                {{/if}}
                {{#if isActive}}
                <span class="tom-scene-library-item__active-frame" aria-hidden="true"></span>
                {{/if}}
              </div>

                <div class="tom-scene-library-item__body">
                  <div class="tom-scene-library-item__title-row">
                  <h3>{{name}}</h3>
                    {{#if isActive}}
                    <span class="tom-scene-library-item__active-badge">{{tr "Active"}}</span>
                    {{/if}}
                  </div>
                  <p>{{#if stageSubtitle}}{{stageSubtitle}}{{else}}{{#if description}}{{description}}{{else}}{{tr "No description available."}}{{/if}}{{/if}}</p>
                  <div class="tom-scene-library-item__meta">
                    <i class="fas fa-users" aria-hidden="true"></i>
                    <span>{{tr "{count} actor(s)" count=actorCount}}</span>
                  </div>
                </div>

              <div class="tom-scene-library-item__actions">
                {{#if isActive}}
                <button type="button" data-action="deactivate-scene" data-scene-id="{{id}}" class="tom-scene-library-action tom-scene-library-action--stop" title="{{tr "Stop scene"}}" aria-label="{{tr "Stop scene"}}">
                  <i class="fas fa-stop" aria-hidden="true"></i>
                </button>
                {{else}}
                <button type="button" data-action="activate-scene" data-scene-id="{{id}}" class="tom-scene-library-action tom-scene-library-action--load" title="{{tr "Load scene"}}" aria-label="{{tr "Load scene"}}">
                  <i class="fas fa-circle-play" aria-hidden="true"></i>
                </button>
                {{/if}}
                <button type="button" data-action="edit-scene" data-scene-id="{{id}}" class="tom-scene-library-action tom-scene-library-action--icon" title="{{tr "Edit scene"}}" aria-label="{{tr "Edit scene"}}">
                  <i class="fas fa-pen-to-square" aria-hidden="true"></i>
                </button>
                <button type="button" data-action="add-stage-goblin-entry" data-stage-goblin-type="theatreScene" data-stage-goblin-id="{{id}}" data-stage-goblin-label="{{name}}" class="tom-scene-library-action tom-scene-library-action--icon" title="{{tr "Add to StageGoblin"}}" aria-label="{{tr "Add to StageGoblin"}}">
                  <i class="fas fa-hat-wizard" aria-hidden="true"></i>
                </button>
                <button type="button" data-action="create-scene-macro" data-scene-id="{{id}}" class="tom-scene-library-action tom-scene-library-action--icon" title="{{tr "Create macro"}}" aria-label="{{tr "Create macro"}}">
                  <i class="fas fa-bolt" aria-hidden="true"></i>
                </button>
                <button type="button" data-action="duplicate-scene" data-scene-id="{{id}}" class="tom-scene-library-action tom-scene-library-action--icon" title="{{tr "Duplicate scene"}}" aria-label="{{tr "Duplicate scene"}}">
                  <i class="fas fa-clone" aria-hidden="true"></i>
                </button>
                <span class="tom-scene-library-action-divider" aria-hidden="true"></span>
                <button type="button" data-action="delete-scene" data-scene-id="{{id}}" class="tom-scene-library-action tom-scene-library-action--delete" title="{{tr "Delete scene"}}" aria-label="{{tr "Delete scene"}}">
                  <i class="fas fa-trash-can" aria-hidden="true"></i>
                </button>
              </div>
            </article>
            {{/if}}
            {{/each}}
          {{else}}
          <div class="tom-scene-library-empty tom-theme-card">
            <i class="fas fa-search" aria-hidden="true"></i>
            <h3>{{tr "No scenes found"}}</h3>
            <p>{{tr "No Footlights scenes match the current search."}}</p>
          </div>
          {{/if}}
        </section>
      </section>
      {{/if}}
    {{/if}}

    {{#if isAvatarsTab}}
      {{#if isAvatarEditorActive}}
      <section class="tom-library-inline-editor tom-library-inline-editor--avatar tom-avatar-config">
