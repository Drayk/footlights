                {{else if isVideoThumbnailFallback}}
                <div class="tom-library-thumbnail tom-library-thumbnail--placeholder tom-library-thumbnail--video" aria-hidden="true">
                  <i class="fas fa-film" aria-hidden="true"></i>
                </div>
