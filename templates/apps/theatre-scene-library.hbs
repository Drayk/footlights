                        <span class="tom-theme-preset__tab is-active">{{sampleTabActive}}</span>
                      </div>
                    </div>

                    <div class="tom-theme-preset__card" aria-hidden="true">
                      <span class="tom-theme-preset__kicker">{{sampleTabPrimary}}</span>
                      <strong class="tom-theme-preset__title">{{sampleTitle}}</strong>
                      <span class="tom-theme-preset__text">{{sampleText}}</span>
                    </div>
                  </div>

                  <div class="tom-theme-preset__meta">
                    <span class="tom-theme-preset__name">{{name}}</span>
                    {{#if isBuiltIn}}
                    <span class="tom-theme-preset__badge">{{tr "Standard"}}</span>
                    {{/if}}
                  </div>

                  <div class="tom-theme-preset__overlay">
                    <button
                      type="button"
                      class="tom-theme-preset__icon"
                      data-action="export-theme-preset"
                      data-preset-id="{{id}}"
                      aria-label="{{tr "Export preset"}}"
                      title="{{tr "Export preset"}}"
                    >
                      <i class="fas fa-file-export" aria-hidden="true"></i>
                    </button>
                    {{#unless isBuiltIn}}
                    <button
                      type="button"
                      class="tom-theme-preset__icon"
                      data-action="import-theme-preset"
                      data-preset-id="{{id}}"
                      aria-label="{{tr "Import preset code"}}"
                      title="{{tr "Import preset code"}}"
                    >
                      <i class="fas fa-file-import" aria-hidden="true"></i>
                    </button>
                    <button
                      type="button"
                      class="tom-theme-preset__icon"
                      data-action="overwrite-theme-preset"
                      data-preset-id="{{id}}"
                      aria-label="{{tr "Overwrite with current settings"}}"
                      title="{{tr "Overwrite with current settings"}}"
                    >
                      <i class="fas fa-rotate" aria-hidden="true"></i>
                    </button>
                    <button
                      type="button"
                      class="tom-theme-preset__icon"
                      data-action="delete-theme-preset"
                      data-preset-id="{{id}}"
                      aria-label="{{tr "Delete preset"}}"
                      title="{{tr "Delete preset"}}"
                    >
                      <i class="fas fa-trash-can" aria-hidden="true"></i>
                    </button>
                    {{/unless}}
                  </div>
                </article>
                {{/each}}

                {{#if themePresetSection.canCreatePreset}}
                <button type="button" class="tom-theme-preset tom-theme-preset--create" data-action="create-theme-preset">
                  <span class="tom-theme-preset__create-icon" aria-hidden="true">
                    <i class="fas fa-plus"></i>
                  </span>
                  <span class="tom-theme-preset__create-label">{{tr "Create preset"}}</span>
                </button>
                {{/if}}
              </div>
            </section>
          </div>
        </section>
        {{/if}}
        {{#each themeSections}}
        <section class="tom-theme-settings__section tom-settings-surface-card tom-theme-surface {{#if isExpanded}}is-expanded{{else}}is-collapsed{{/if}}" data-theme-section="{{key}}">
          <button
            type="button"
            class="tom-theme-settings__section-toggle"
            data-action="toggle-theme-section"
            data-theme-section-key="{{key}}"
            aria-expanded="{{#if isExpanded}}true{{else}}false{{/if}}"
          >
            <div class="tom-theme-settings__section-header">
              <div>
                <h3>{{title}}</h3>
                <p class="notes">{{description}}</p>
              </div>
              <div class="tom-theme-settings__section-meta">
                <i class="fas {{#if isExpanded}}fa-chevron-down{{else}}fa-chevron-right{{/if}}" aria-hidden="true"></i>
              </div>
            </div>
          </button>
          <div class="tom-theme-settings__groups">
            {{#each groups}}
            {{#unless isHidden}}
            <section class="tom-theme-settings__group">
              <header class="tom-theme-settings__group-header">
                <h4>{{title}}</h4>
              </header>

              <div class="tom-theme-settings__items">
                {{#each items}}
                <article class="tom-theme-item tom-theme-card {{#if isSelected}}is-selected{{/if}}" data-action="select-theme-item" data-theme-key="{{key}}" tabindex="0" role="button" aria-pressed="{{#if isSelected}}true{{else}}false{{/if}}">
                  <div class="tom-theme-item__preview-block">
                    <span class="tom-theme-item__label">{{label}}</span>
                    {{{previewHtml}}}
                  </div>
                </article>
                {{/each}}
              </div>
            </section>
            {{/unless}}
            {{/each}}
            {{#if isStageGoblin}}
            <section class="tom-stage-goblin-setup tom-stage-goblin-setup--theme-section">
              <div class="tom-stage-goblin-setup__top">
                <div class="form-group">
                  <span>{{tr "Visible bars"}}</span>
                  <div class="tom-stage-goblin-setup__count-control">
                    <button type="button" data-action="adjust-stage-goblin-bar-count" data-stage-goblin-count-delta="-1" aria-label="{{tr "Fewer bars"}}" title="{{tr "Fewer bars"}}">
                      <i class="fas fa-minus" aria-hidden="true"></i>
                    </button>
                    <input type="hidden" name="stageGoblin.barCount" value="{{../stageGoblinSetup.barCount}}" />
                    <output data-stage-goblin-bar-count>{{../stageGoblinSetup.barCount}}</output>
                    <button type="button" data-action="adjust-stage-goblin-bar-count" data-stage-goblin-count-delta="1" aria-label="{{tr "More bars"}}" title="{{tr "More bars"}}">
                      <i class="fas fa-plus" aria-hidden="true"></i>
                    </button>
                  </div>
                </div>
              </div>

              <div class="tom-stage-goblin-setup__bars">
                {{#each ../stageGoblinSetup.bars}}
                <section class="tom-stage-goblin-setup__bar tom-stage-goblin-setup__bar--compact tom-theme-card {{#if isSelected}}is-selected{{/if}} {{#unless isVisibleInSetup}}is-hidden{{/unless}}" data-stage-goblin-setup-bar-index="{{number}}" data-action="select-theme-item" data-theme-key="stageGoblin.setup.{{@index}}" tabindex="0" role="button">
                  <span class="tom-stage-goblin-setup__tag-preview" style="--tom-stage-goblin-tag-preview:{{tagColor}};--tom-stage-goblin-tag-preview-text:{{tagTextColor}};">
                    {{#if label}}{{label}}{{else}}{{tr "Stage Goblin Bar {number}" number=number}}{{/if}}
                  </span>
                  <label class="form-group">
                    <span>{{tr "Name"}}</span>
                    <input type="text" name="stageGoblin.bars.{{@index}}.label" value="{{label}}" />
                  </label>
                </section>
                {{/each}}
              </div>
            </section>
            {{/if}}
          </div>
        </section>
        {{/each}}
        </section>
      </div>
      </section>
      </div>

        <aside class="tom-theme-inspector tom-settings-inspector-panel tom-theme-surface tom-theme-workspace__inspector" {{#if selectedThemeItem}}data-theme-key="{{selectedThemeItem.key}}"{{/if}}>
          {{#if selectedThemeItem}}
          <header class="tom-theme-inspector__header">
            <div>
              <p class="notes">{{selectedThemeItem.sectionTitle}} / {{selectedThemeItem.groupTitle}}</p>
              <h3>{{selectedThemeItem.label}}</h3>
            </div>
          </header>

          <div class="tom-theme-inspector__preview {{#if selectedThemeItem.isStageGoblinSetupPreview}}tom-theme-inspector__preview--stage-goblin-setup{{/if}}">
            {{{selectedThemeItem.previewHtml}}}
          </div>

          <div class="tom-theme-item__controls">
            {{#each selectedThemeItem.controls}}
            {{#if isControlSectionTitle}}
            <h4 class="tom-theme-control-section-title">{{label}}</h4>
            {{else}}
            <section class="{{#if isStageGoblinBarSettings}}tom-stage-goblin-inspector-wrap{{else}}tom-theme-control-group tom-theme-card{{/if}}">
              {{#if showHeader}}
              <header class="tom-theme-control-group__header">
                <h4>{{label}}</h4>
              </header>
              {{/if}}

              {{#if isControlPanel}}
              <div class="tom-theme-control-panel">
                {{#each controls}}
                {{#if isColor}}
                <div class="tom-theme-control-row">
                  <label>{{label}}</label>
                  <div class="tom-theme-control-row__fields">
                    <input type="color" name="themeEditor.{{key}}.color" value="{{color}}" />
                    <input type="range" min="0" max="100" step="1" name="themeEditor.{{key}}.alpha" value="{{alpha}}" />
                    <span data-theme-alpha-display-for="themeEditor.{{key}}.alpha">{{alpha}}%</span>
                  </div>
                </div>
                {{/if}}
                {{#if isRange}}
                <div class="tom-theme-control-row">
                  <label>{{label}}</label>
                  <div class="tom-theme-control-row__fields tom-theme-control-row__fields--size">
                    <input type="range" min="{{min}}" max="{{max}}" step="{{step}}" name="themeEditor.{{key}}" value="{{value}}" />
                    <span data-theme-range-display-for="themeEditor.{{key}}" data-theme-range-unit="{{unit}}">{{value}}{{unit}}</span>
                  </div>
                </div>
                {{/if}}
                {{#if isSelect}}
                <div class="tom-theme-control-row">
                  <label>{{label}}</label>
                  <div class="tom-theme-control-row__fields">
                    <select name="themeEditor.{{key}}">
                      {{selectOptions options selected=value valueAttr="value" labelAttr="label"}}
                    </select>
                  </div>
                </div>
                {{/if}}
                {{/each}}
              </div>
              {{/if}}

              {{#if isGradient}}
              <div class="tom-theme-control-row">
                <label>{{tr "Start"}}</label>
                <div class="tom-theme-control-row__fields">
                  <input type="color" name="themeEditor.{{key}}Start.color" value="{{startColor}}" />
                  <input type="range" min="0" max="100" step="1" name="themeEditor.{{key}}Start.alpha" value="{{startAlpha}}" />
                  <span data-theme-alpha-display-for="themeEditor.{{key}}Start.alpha">{{startAlpha}}%</span>
                </div>
              </div>
              <div class="tom-theme-control-row">
                <label>{{tr "End"}}</label>
                <div class="tom-theme-control-row__fields">
                  <input type="color" name="themeEditor.{{key}}End.color" value="{{endColor}}" />
                  <input type="range" min="0" max="100" step="1" name="themeEditor.{{key}}End.alpha" value="{{endAlpha}}" />
                  <span data-theme-alpha-display-for="themeEditor.{{key}}End.alpha">{{endAlpha}}%</span>
                </div>
              </div>
              {{#each extraColorControls}}
              <div class="tom-theme-control-row">
                <label>{{label}}</label>
                <div class="tom-theme-control-row__fields">
                  <input type="color" name="themeEditor.{{key}}.color" value="{{color}}" />
                  <input type="range" min="0" max="100" step="1" name="themeEditor.{{key}}.alpha" value="{{alpha}}" />
                  <span data-theme-alpha-display-for="themeEditor.{{key}}.alpha">{{alpha}}%</span>
                </div>
              </div>
              {{/each}}
              {{#each extraRangeControls}}
              <div class="tom-theme-control-row">
                <label>{{label}}</label>
                <div class="tom-theme-control-row__fields tom-theme-control-row__fields--size">
                  <input type="range" min="{{min}}" max="{{max}}" step="{{step}}" name="themeEditor.{{key}}" value="{{value}}" />
                  <span data-theme-range-display-for="themeEditor.{{key}}" data-theme-range-unit="{{unit}}">{{value}}{{unit}}</span>
                </div>
              </div>
              {{/each}}
              {{/if}}

              {{#if isColor}}
              <div class="tom-theme-control-row">
                <div class="tom-theme-control-row__fields">
                  <input type="color" name="themeEditor.{{key}}.color" value="{{color}}" />
                  <input type="range" min="0" max="100" step="1" name="themeEditor.{{key}}.alpha" value="{{alpha}}" />
                  <span data-theme-alpha-display-for="themeEditor.{{key}}.alpha">{{alpha}}%</span>
                </div>
              </div>
              {{/if}}

              {{#if isRange}}
              <div class="tom-theme-control-row">
                <div class="tom-theme-control-row__fields tom-theme-control-row__fields--size">
                  <input type="range" min="{{min}}" max="{{max}}" step="{{step}}" name="themeEditor.{{key}}" value="{{value}}" />
                  <span data-theme-range-display-for="themeEditor.{{key}}" data-theme-range-unit="{{unit}}">{{value}}{{unit}}</span>
                </div>
              </div>
              {{/if}}

              {{#if isTypographyHover}}
              <div class="tom-theme-control-row">
                <label>{{tr "Size"}}</label>
                <div class="tom-theme-control-row__fields tom-theme-control-row__fields--size">
                  <input type="range" min="{{min}}" max="{{max}}" step="{{step}}" name="themeEditor.{{key}}" value="{{value}}" />
                  <span data-theme-range-display-for="themeEditor.{{key}}" data-theme-range-unit="{{unit}}">{{value}}{{unit}}</span>
                </div>
              </div>
              <div class="tom-theme-control-row">
                <label>{{tr "Color"}}</label>
                <div class="tom-theme-control-row__fields">
                  <input type="color" name="themeEditor.{{colorKey}}.color" value="{{color}}" />
                  <input type="range" min="0" max="100" step="1" name="themeEditor.{{colorKey}}.alpha" value="{{alpha}}" />
                  <span data-theme-alpha-display-for="themeEditor.{{colorKey}}.alpha">{{alpha}}%</span>
                </div>
              </div>
              {{/if}}

              {{#if isSelect}}
              <div class="tom-theme-control-row">
                <div class="tom-theme-control-row__fields">
                  <select name="themeEditor.{{key}}">
                    {{selectOptions options selected=value valueAttr="value" labelAttr="label"}}
                  </select>
                </div>
              </div>
              {{/if}}

              {{#if isText}}
              <div class="tom-theme-control-row">
                <div class="tom-theme-control-row__fields tom-theme-control-row__fields--text">
                  <input type="text" name="themeEditor.{{key}}" value="{{value}}" placeholder="{{placeholder}}" />
                  {{#if imagePicker}}
                  <button
                    type="button"
                    class="tom-button tom-button-ghost tom-button-icon"
                    data-action="pick-image"
                    data-target="[name='themeEditor.{{key}}']"
                    aria-label="{{tr "Choose image"}}"
                    title="{{tr "Choose image"}}"
                  >
                    <i class="fas fa-image" aria-hidden="true"></i>
                  </button>
                  {{/if}}
                </div>
              </div>
              {{/if}}

              {{#if isStageGoblinBarSettings}}
              <div class="tom-stage-goblin-inspector-fields">
                <details class="tom-stage-goblin-inspector-section tom-theme-card" open>
                  <summary><h4>{{tr "Tags"}}</h4><i class="fas fa-chevron-down" aria-hidden="true"></i></summary>
                  <label class="tom-toggle-switch tom-stage-goblin-setup__toggle {{#if bar.showLabel}}is-checked{{/if}}"><span class="tom-toggle-switch__label">{{tr "Show name tags"}}</span><input type="checkbox" name="stageGoblin.bars.{{bar.index}}.showLabel" {{#if bar.showLabel}}checked{{/if}} /><span class="tom-toggle-switch__track" aria-hidden="true"><span class="tom-toggle-switch__knob"></span></span></label>
                  <label class="form-group"><span>{{tr "Tag position"}}</span><select name="stageGoblin.bars.{{bar.index}}.tagPosition">{{#each bar.tagPositionOptions}}<option value="{{value}}" {{#if isSelected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  <label class="form-group tom-stage-goblin-color-field"><span>{{tr "Tag color"}}</span><div class="tom-stage-goblin-color-field__controls"><input type="color" name="stageGoblin.bars.{{bar.index}}.tagColor" value="{{bar.tagColor}}" /><input type="range" min="0" max="100" step="1" name="stageGoblin.bars.{{bar.index}}.tagAlpha" value="{{bar.tagAlphaPercent}}" /></div></label>
                  <label class="form-group tom-stage-goblin-color-field"><span>{{tr "Tag text color"}}</span><div class="tom-stage-goblin-color-field__controls"><input type="color" name="stageGoblin.bars.{{bar.index}}.tagTextColor" value="{{bar.tagTextColor}}" /><input type="range" min="0" max="100" step="1" name="stageGoblin.bars.{{bar.index}}.tagTextAlpha" value="{{bar.tagTextAlphaPercent}}" /></div></label>
                  <label class="form-group"><span>{{tr "Tag font size"}}</span><input type="range" min="0.2" max="1.2" step="0.01" name="stageGoblin.bars.{{bar.index}}.tagFontSize" value="{{bar.tagFontSize}}" /></label>
                  <label class="form-group"><span>{{tr "Tag height"}}</span><input type="range" min="10" max="52" step="1" name="stageGoblin.bars.{{bar.index}}.tagHeight" value="{{bar.tagHeight}}" /></label>
                  <label class="form-group"><span>{{tr "Tag width"}}</span><input type="range" min="36" max="180" step="1" name="stageGoblin.bars.{{bar.index}}.tagWidth" value="{{bar.tagWidth}}" /></label>
                  <label class="form-group"><span>{{tr "Tag rounded borders"}}</span><input type="range" min="0" max="16" step="1" name="stageGoblin.bars.{{bar.index}}.tagRadius" value="{{bar.tagRadius}}" /></label>
                  <label class="tom-toggle-switch tom-stage-goblin-setup__toggle {{#if bar.tagGlowEnabled}}is-checked{{/if}}"><span class="tom-toggle-switch__label">{{tr "Tag glow"}}</span><input type="checkbox" name="stageGoblin.bars.{{bar.index}}.tagGlowEnabled" {{#if bar.tagGlowEnabled}}checked{{/if}} /><span class="tom-toggle-switch__track" aria-hidden="true"><span class="tom-toggle-switch__knob"></span></span></label>
                  <label class="form-group"><span>{{tr "Tag glow blur"}}</span><input type="range" min="0" max="32" step="1" name="stageGoblin.bars.{{bar.index}}.tagGlowBlur" value="{{bar.tagGlowBlur}}" /></label>
                </details>
                <details class="tom-stage-goblin-inspector-section tom-theme-card" open>
                  <summary><h4>{{tr "StageGoblin Bar"}}</h4><i class="fas fa-chevron-down" aria-hidden="true"></i></summary>
                  <label class="tom-toggle-switch tom-stage-goblin-setup__toggle {{#if bar.isVertical}}is-checked{{/if}}"><span class="tom-toggle-switch__label">{{tr "Vertical entries"}}</span><input type="checkbox" name="stageGoblin.bars.{{bar.index}}.orientation" value="vertical" {{#if bar.isVertical}}checked{{/if}} /><span class="tom-toggle-switch__track" aria-hidden="true"><span class="tom-toggle-switch__knob"></span></span></label>
                  <label class="form-group tom-stage-goblin-vertical-only {{#unless bar.isVertical}}is-hidden{{/unless}}" data-stage-goblin-vertical-only="{{bar.index}}"><span>{{tr "Vertical card height"}}</span><input type="range" min="18" max="72" step="1" name="stageGoblin.bars.{{bar.index}}.verticalItemHeight" value="{{bar.verticalItemHeight}}" /></label>
                  <label class="form-group tom-stage-goblin-color-field"><span>{{tr "Background"}}</span><div class="tom-stage-goblin-color-field__controls"><input type="color" name="stageGoblin.bars.{{bar.index}}.surfaceColor" value="{{bar.surfaceColor}}" /><input type="range" min="0" max="100" step="1" name="stageGoblin.bars.{{bar.index}}.surfaceAlpha" value="{{bar.surfaceAlphaPercent}}" /></div></label>
                  <label class="form-group tom-stage-goblin-color-field"><span>{{tr "Borders"}}</span><div class="tom-stage-goblin-color-field__controls"><input type="color" name="stageGoblin.bars.{{bar.index}}.borderColor" value="{{bar.borderColor}}" /><input type="range" min="0" max="100" step="1" name="stageGoblin.bars.{{bar.index}}.borderAlpha" value="{{bar.borderAlphaPercent}}" /></div></label>
                  <label class="form-group"><span>{{tr "Icon size"}}</span><input type="range" min="0.62" max="2.4" step="0.01" name="stageGoblin.bars.{{bar.index}}.iconSize" value="{{bar.iconSize}}" /></label>
                  <label class="form-group tom-stage-goblin-color-field"><span>{{tr "Icon"}}</span><div class="tom-stage-goblin-color-field__controls"><input type="color" name="stageGoblin.bars.{{bar.index}}.iconColor" value="{{bar.iconColor}}" /><input type="range" min="0" max="100" step="1" name="stageGoblin.bars.{{bar.index}}.iconAlpha" value="{{bar.iconAlphaPercent}}" /></div></label>
                  <label class="form-group tom-stage-goblin-color-field"><span>{{tr "Standard text color"}}</span><div class="tom-stage-goblin-color-field__controls"><input type="color" name="stageGoblin.bars.{{bar.index}}.textColor" value="{{bar.textColor}}" /><input type="range" min="0" max="100" step="1" name="stageGoblin.bars.{{bar.index}}.textAlpha" value="{{bar.textAlphaPercent}}" /></div></label>
                  <label class="form-group"><span>{{tr "Border width"}}</span><input type="range" min="0" max="6" step="0.1" name="stageGoblin.bars.{{bar.index}}.borderWidth" value="{{bar.borderWidth}}" /></label>
                  <label class="form-group"><span>{{tr "Corner radius"}}</span><input type="range" min="0" max="40" step="1" name="stageGoblin.bars.{{bar.index}}.radius" value="{{bar.radius}}" /></label>
                  <label class="form-group"><span>{{tr "Font size"}}</span><input type="range" min="0.4" max="1.6" step="0.01" name="stageGoblin.bars.{{bar.index}}.fontSize" value="{{bar.fontSize}}" /></label>
                </details>
              </div>
              {{/if}}

            </section>
            {{/if}}
            {{/each}}
          </div>
          {{/if}}
        </aside>
      </div>
    </section>
    {{/if}}
    </div>
  </section>
</form>
