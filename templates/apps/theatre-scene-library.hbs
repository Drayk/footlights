                {{else}}
                <button type="button" data-action="activate-scene" data-scene-id="{{id}}" class="tom-button tom-button-icon tom-library-action tom-library-action--play" title="{{tr "Load scene"}}" aria-label="{{tr "Load scene"}}">
                  <i class="fas fa-circle-play" aria-hidden="true"></i>
