                title="{{tr "Choose default frame"}}"
              >
                <i class="fas fa-folder-open" aria-hidden="true"></i>
                <span>{{tr "Browse"}}</span>
              </button>
            </div>
          </div>
        </aside>

        <section class="tom-library-list tom-avatar-library-list">
