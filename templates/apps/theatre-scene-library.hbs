                  <input type="hidden" name="sceneEditor.actors.{{index}}.activeScale" value="{{activeScale}}" />
                  <input type="hidden" name="sceneEditor.actors.{{index}}.imageOverride" value="{{imageOverride}}" />
                  <input type="hidden" name="sceneEditor.actors.{{index}}.disableMoods" value="{{disableMoods}}" />
                  <input type="hidden" name="sceneEditor.actors.{{index}}.useCircularCrop" value="{{useCircularCrop}}" />
                  <input type="hidden" name="sceneEditor.actors.{{index}}.circularCropScale" value="{{circularCropScale}}" />
                  <input type="hidden" name="sceneEditor.actors.{{index}}.cropOffsetX" value="{{cropOffsetX}}" />
                  <input type="hidden" name="sceneEditor.actors.{{index}}.cropOffsetY" value="{{cropOffsetY}}" />
                  <input type="hidden" name="sceneEditor.actors.{{index}}.frameFitScale" value="{{frameFitScale}}" />
                  <input type="hidden" name="sceneEditor.actors.{{index}}.frameImage" value="{{frameImage}}" />
                  <input type="hidden" name="sceneEditor.actors.{{index}}.showBackdrop" value="{{showBackdrop}}" />
                  <input type="hidden" name="sceneEditor.actors.{{index}}.mirrored" value="{{mirrored}}" />
                  <input type="hidden" name="sceneEditor.actors.{{index}}.showName" value="{{showName}}" />
                  <input type="hidden" name="sceneEditor.actors.{{index}}.isVisible" value="{{isVisible}}" />
                  <input type="hidden" name="sceneEditor.actors.{{index}}.offsetX" value="{{offsetX}}" />
                  <input type="hidden" name="sceneEditor.actors.{{index}}.offsetY" value="{{offsetY}}" />

                  <div class="tom-scene-actor-preview">
