                  <label class="form-group"><span>{{tr "Perspective"}}</span><input type="number" name="portalEffect.{{id}}.perspective" value="{{settings.perspective}}" min="250" max="1600" step="25" /></label>
                  {{/if}}

                  {{#if isPulse}}
                  <label class="form-group"><span>{{tr "Scale"}}</span><input type="number" name="portalEffect.{{id}}.scale" value="{{settings.scale}}" min="0.7" max="1.6" step="0.01" /></label>
                  <label class="form-group tom-portal-editor-range"><span>{{tr "Opacity"}}</span><input type="range" name="portalEffect.{{id}}.opacity" value="{{settings.opacity}}" min="0" max="1" step="0.05" /></label>
                  <label class="form-group"><span>{{tr "Duration"}}</span><input type="number" name="portalEffect.{{id}}.duration" value="{{settings.duration}}" min="0.2" max="12" step="0.1" /></label>
                  {{/if}}

                  {{#if isFloat}}
                  <label class="form-group tom-portal-editor-inspector-grid__wide"><span>{{tr "Distance"}}</span><input type="number" name="portalEffect.{{id}}.distance" value="{{settings.distance}}" min="0" max="40" step="0.5" /></label>
                  <label class="form-group"><span>{{tr "Rotation"}}</span><input type="number" name="portalEffect.{{id}}.rotation" value="{{settings.rotation}}" min="-12" max="12" step="0.1" /></label>
                  <label class="form-group"><span>{{tr "Duration"}}</span><input type="number" name="portalEffect.{{id}}.duration" value="{{settings.duration}}" min="0.4" max="20" step="0.1" /></label>
                  {{/if}}

                  {{#if isPerspectiveHover}}
                  <label class="form-group"><span>X</span><input type="number" name="portalEffect.{{id}}.x" value="{{settings.x}}" min="-75" max="75" step="1" /></label>
                  <label class="form-group"><span>Y</span><input type="number" name="portalEffect.{{id}}.y" value="{{settings.y}}" min="-75" max="75" step="1" /></label>
                  <label class="form-group"><span>{{tr "Perspective"}}</span><input type="number" name="portalEffect.{{id}}.perspective" value="{{settings.perspective}}" min="250" max="1800" step="25" /></label>
                  <label class="form-group"><span>{{tr "Scale"}}</span><input type="number" name="portalEffect.{{id}}.scale" value="{{settings.scale}}" min="0.5" max="2" step="0.01" /></label>
                  {{/if}}

                  {{#if isSound}}
                  <div class="form-group tom-portal-editor-inspector-grid__wide">
                    <label>{{tr "Sound file"}}</label>
                    <div class="tom-input-with-button">
                      <input type="text" name="portalEffect.{{id}}.src" value="{{settings.src}}" />
                      <button type="button" class="tom-button" data-action="pick-audio" data-target="[name='portalEffect.{{id}}.src']" data-picker-type="audio">
                        <i class="fas fa-folder-open" aria-hidden="true"></i><span>{{tr "Browse"}}</span>
                      </button>
                    </div>
                  </div>
                  <label class="form-group tom-portal-editor-range">
                    <span>{{tr "Volume"}}</span>
                    <input type="range" name="portalEffect.{{id}}.volume" value="{{settings.volume}}" min="0" max="1" step="0.05" />
                  </label>
                  {{/if}}
                    </div>
                  </details>
                </div>
                {{/if}}
              </section>
              {{/each}}
            </div>
            <p class="notes tom-portal-editor-effects-hint">{{tr "Effects are applied from top to bottom. Use the plus button to add Glow, Blur, Rotate, Tilt, or Pulse."}}</p>
          </details>

          {{else}}
          <div class="tom-portal-editor-empty">
            <i class="fas fa-sliders" aria-hidden="true"></i>
            <span>{{tr "Select or create an element to edit it."}}</span>
          </div>
          {{/if}}
          </div>
        </aside>
      </div>
