                    <span class="tom-avatar-accordion__icon" aria-hidden="true">
                      <i class="fas fa-image"></i>
                    </span>
                    <span>
                      <span class="tom-avatar-accordion__title">{{tr "Visual Assets"}}</span>
                      <span class="tom-avatar-accordion__description">{{tr "Base image and optional overlay frame."}}</span>
                    </span>
                  </span>
                  <i class="fas fa-chevron-right tom-avatar-accordion__chevron" aria-hidden="true"></i>
