                    <i class="fas fa-play" aria-hidden="true"></i>
                  </button>
                  {{/if}}
                </div>
              </div>
            </article>
            {{else}}
              <article class="tom-library-card tom-theme-card {{#if isActive}}is-active{{/if}}" draggable="true" data-drag-theatre-scene="true" data-scene-id="{{id}}" data-library-search-tab="scenes" data-library-search-text="{{name}} {{stageTitle}} {{stageSubtitle}} {{description}} {{location}} {{tags}}">
                <div class="tom-library-card__media">
