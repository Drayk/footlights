          {{else}}
          <div class="tom-avatar-library-empty tom-theme-card">
            <i class="fas fa-search" aria-hidden="true"></i>
            <h3>{{tr "No avatars found"}}</h3>
            <p class="notes">{{tr "No reusable avatars match the current search."}}</p>
          </div>
          {{/if}}
        </section>
      </section>
      {{/if}}
