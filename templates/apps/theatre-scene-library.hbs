            {{#each planners}}
            <article class="tom-planner-library-item tom-theme-card" data-library-search-tab="mindmap" data-library-search-text="{{name}}">
              <div class="tom-planner-library-item__preview">
                {{#if thumbnail}}
                <img src="{{thumbnail}}" alt="{{name}}" class="tom-planner-library-item__thumbnail" />
                {{else}}
                <div class="tom-planner-library-item__placeholder" aria-hidden="true">
                  <i class="fas fa-diagram-project"></i>
                </div>
                {{/if}}
              </div>

              <div class="tom-planner-library-item__content">
                <h3>{{name}}</h3>
                <div class="tom-planner-library-item__meta">
                  <span><strong>{{nodeCount}}</strong> {{tr "Node(s)"}}</span>
                  <span aria-hidden="true" class="tom-planner-library-item__dot"></span>
                  <span><strong>{{edgeCount}}</strong> {{tr "Connection(s)"}}</span>
                </div>
              </div>

              <div class="tom-planner-library-item__actions">
                <button type="button" data-action="open-mindmap" data-planner-id="{{id}}" class="tom-button tom-planner-library-open" title="{{tr "Open Adventure Planner"}}" aria-label="{{tr "Open Adventure Planner"}}">
                  <i class="fas fa-up-right-from-square" aria-hidden="true"></i>
                </button>
                <span class="tom-planner-library-action-divider" aria-hidden="true"></span>
                <button type="button" data-action="edit-planner" data-planner-id="{{id}}" class="tom-button tom-planner-library-action" title="{{tr "Edit Adventure Planner"}}" aria-label="{{tr "Edit Adventure Planner"}}">
                  <i class="fas fa-pen-to-square" aria-hidden="true"></i>
                </button>
                <button type="button" data-action="duplicate-planner" data-planner-id="{{id}}" class="tom-button tom-planner-library-action" title="{{tr "Duplicate Adventure Planner"}}" aria-label="{{tr "Duplicate Adventure Planner"}}">
                  <i class="fas fa-clone" aria-hidden="true"></i>
                </button>
                <button type="button" data-action="delete-planner" data-planner-id="{{id}}" class="tom-button tom-planner-library-action tom-planner-library-action--delete" title="{{tr "Delete Adventure Planner"}}" aria-label="{{tr "Delete Adventure Planner"}}">
