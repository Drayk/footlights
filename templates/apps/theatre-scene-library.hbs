                <button type="button" data-action="delete-scene" data-scene-id="{{id}}" class="tom-button tom-button-icon tom-library-action tom-library-action--delete" title="{{tr "Delete scene"}}" aria-label="{{tr "Delete scene"}}">
                  <i class="fas fa-trash-can" aria-hidden="true"></i>
                </button>
              </div>
            </article>
            {{/if}}
            {{/each}}
          {{else}}
