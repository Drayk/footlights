                    </div>
                  </div>

                  <div class="tom-scene-actor-fields">
                    <div class="form-group">
                      <label>{{tr "Initial mood"}}</label>
                      <select name="sceneEditor.actors.{{index}}.initialMood">
                        {{selectOptions ../sceneEditorMoodPresets selected=initialMood}}
                      </select>
                    </div>
                  </div>

                  <div class="tom-scene-actor-actions">
                    {{#unless hasLibraryAvatar}}
