<form class="tom-scene-library tom-theme-root tom-theme-default {{#if isPortalEditorActive}}is-portal-stage-editor{{/if}}" style="{{themeInlineStyle}}">
  <section class="tom-library-shell-head tom-theme-area tom-theme-area--navigation">
    <div class="tom-library-shell-head__media" style="{{navigationSurfaceMediaStyle}}"></div>
    <div class="tom-library-shell-head__content">
      <div class="tom-library-topbar">
        <div class="tom-library-topbar__brand">
          <img
            class="tom-library-topbar__logo"
            src="{{libraryLogoSrc}}"
            alt="{{tr "Footlights Library"}}"
          >
        </div>

        <nav class="tom-library-topnav" aria-label="{{tr "Footlights sections"}}">
          {{#each primaryTabs}}
          <button
            type="button"
            class="tom-library-tab tom-button {{#if isActive}}tom-button-primary is-active{{else}}tom-button-ghost{{/if}}"
            data-action="switch-tab"
            data-tab="{{id}}"
            aria-pressed="{{#if isActive}}true{{else}}false{{/if}}"
          >
            <span>{{label}}</span>
          </button>
          {{/each}}
        </nav>

        <div class="tom-library-topbar__tools">
          {{#if showLibrarySearch}}
          <label class="tom-library-search">
            <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
            <input
              type="text"
              data-action="library-search"
              value="{{librarySearchValue}}"
              placeholder="{{librarySearchPlaceholder}}"
              aria-label="{{librarySearchPlaceholder}}"
            />
          </label>
          {{/if}}

          <div class="tom-library-topbar__actions">
            {{#if headerContext.showCancelSceneEditor}}
            <button type="button" class="tom-button tom-button-danger tom-button-icon" data-action="cancel-scene-editor" aria-label="{{tr "Cancel editing"}}" title="{{tr "Cancel"}}">
              <i class="fas fa-xmark" aria-hidden="true"></i>
            </button>
            {{/if}}
            {{#if headerContext.showSaveSceneEditor}}
            <button type="button" class="tom-button tom-button-success tom-button-icon tom-library-safe-button" data-action="save-scene-editor" aria-label="{{tr "Save scene"}}" title="{{tr "Save"}}">
              <i class="fas fa-save" aria-hidden="true"></i>
            </button>
            {{/if}}
            {{#if headerContext.showCancelAvatarEditor}}
            <button type="button" class="tom-button tom-button-danger tom-button-icon" data-action="cancel-avatar-editor" aria-label="{{tr "Cancel editing"}}" title="{{tr "Cancel"}}">
              <i class="fas fa-xmark" aria-hidden="true"></i>
            </button>
            {{/if}}
            {{#if headerContext.showSaveAvatarEditor}}
            <button type="button" class="tom-button tom-button-success tom-button-icon tom-library-safe-button" data-action="save-avatar-editor" aria-label="{{tr "Save avatar"}}" title="{{tr "Save"}}">
              <i class="fas fa-save" aria-hidden="true"></i>
            </button>
            {{/if}}
            {{#if headerContext.showCancelSoundPlaylistEditor}}
            <button type="button" class="tom-button tom-button-danger tom-button-icon" data-action="cancel-sound-playlist-editor" aria-label="{{tr "Cancel editing"}}" title="{{tr "Cancel"}}">
              <i class="fas fa-xmark" aria-hidden="true"></i>
            </button>
            {{/if}}
            {{#if headerContext.showSaveSoundPlaylistEditor}}
            <button type="button" class="tom-button tom-button-success tom-button-icon tom-library-safe-button" data-action="save-sound-playlist-editor" aria-label="{{tr "Save playlist"}}" title="{{tr "Save"}}">
              <i class="fas fa-save" aria-hidden="true"></i>
            </button>
            {{/if}}
            {{#if headerContext.showCancelMapEditor}}
            <button type="button" class="tom-button tom-button-danger tom-button-icon" data-action="cancel-map-editor" aria-label="{{tr "Cancel editing"}}" title="{{tr "Cancel"}}">
              <i class="fas fa-xmark" aria-hidden="true"></i>
            </button>
            {{/if}}
            {{#if headerContext.showSaveMapEditor}}
            <button type="button" class="tom-button tom-button-success tom-button-icon tom-library-safe-button" data-action="save-map-editor" aria-label="{{tr "Save map"}}" title="{{tr "Save"}}">
              <i class="fas fa-save" aria-hidden="true"></i>
            </button>
            {{/if}}
            {{#if headerContext.showCloseInlineMindmap}}
            <button type="button" class="tom-button tom-button-danger tom-button-icon" data-action="close-inline-mindmap" aria-label="{{tr "Back to planner overview"}}" title="{{tr "Close"}}">
              <i class="fas fa-xmark" aria-hidden="true"></i>
            </button>
            {{/if}}
            {{#if headerContext.showSaveMoods}}
            <button type="button" class="tom-button tom-button-success tom-button-icon tom-library-safe-button" data-action="save-moods" aria-label="{{tr "Save moods"}}" title="{{tr "Save"}}">
              <i class="fas fa-save" aria-hidden="true"></i>
            </button>
            {{/if}}

            {{#if headerContext.showCreatePlanner}}
            <button type="button" class="tom-button tom-library-create-button" data-action="create-planner" aria-label="{{tr "Create new planner"}}" title="{{tr "New Planner"}}">
              <span>{{tr "Create"}}</span>
            </button>
            {{/if}}
            {{#if headerContext.showCreateScene}}
            <button type="button" class="tom-button tom-library-create-button" data-action="create-scene" aria-label="{{tr "Create new scene"}}" title="{{tr "New Scene"}}">
              <span>{{tr "Create"}}</span>
            </button>
            {{/if}}
            {{#if headerContext.showCreateAvatar}}
            <button type="button" class="tom-button tom-library-create-button" data-action="create-avatar" aria-label="{{tr "Create new avatar"}}" title="{{tr "New Avatar"}}">
              <span>{{tr "Create"}}</span>
            </button>
            {{/if}}
            {{#if headerContext.showCreateSoundPlaylist}}
            <button type="button" class="tom-button tom-library-create-button" data-action="create-sound-playlist" aria-label="{{tr "Create new sound playlist"}}" title="{{tr "New Playlist"}}">
              <span>{{tr "Create"}}</span>
            </button>
            {{/if}}
            {{#if headerContext.showCreateMap}}
            <button type="button" class="tom-button tom-library-create-button" data-action="create-map" aria-label="{{tr "Create new map"}}" title="{{tr "New Map"}}">
              <span>{{tr "Create"}}</span>
            </button>
            {{/if}}
            {{#if headerContext.showCreatePortal}}
            <button type="button" class="tom-button tom-library-create-button" data-action="create-portal" aria-label="{{tr "Create new portal"}}" title="{{tr "New Portal"}}">
              <span>{{tr "Create"}}</span>
            </button>
            {{/if}}

            <button
              type="button"
              class="tom-button tom-button-icon tom-library-settings-button {{#if isSettingsTab}}is-active{{/if}}"
              data-action="switch-tab"
              data-tab="settings"
              aria-label="{{tr "Settings"}}"
              title="{{tr "Settings"}}"
              aria-pressed="{{#if isSettingsTab}}true{{else}}false{{/if}}"
            >
              <i class="fas fa-gear" aria-hidden="true"></i>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="tom-library-content tom-library-content--shell tom-theme-area tom-theme-area--content">
    <div class="tom-library-content__body">
    {{#unless isMindmapTab}}
      {{#unless isAvatarsTab}}
      {{#unless isMapsTab}}
      {{#unless isPortalsTab}}
      {{#unless isScenesTab}}
      {{#unless isSoundsTab}}
      {{#unless isSettingsTab}}
      {{#unless isAvatarEditorActive}}
      {{#unless isSceneEditorActive}}
      <header class="tom-library-section-header">
        <h1>{{headerContext.title}}</h1>
        {{#if headerContext.description}}
        <p class="notes">{{headerContext.description}}</p>
        {{/if}}
      </header>
      {{/unless}}
      {{/unless}}
      {{/unless}}
      {{/unless}}
      {{/unless}}
      {{/unless}}
      {{/unless}}
      {{/unless}}
      {{/unless}}
    {{#if isScenesTab}}
      {{#if isSceneEditorActive}}
      <div class="tom-scene-config-layout tom-scene-config-layout--inline">
        <header class="tom-scene-config-hero">
          <span class="tom-scene-config-hero__icon" aria-hidden="true">
            <i class="fas fa-clapperboard"></i>
          </span>
          <span class="tom-scene-config-hero__copy">
            <h1>{{#if sceneEditor.name}}{{sceneEditor.name}}{{else}}{{tr "Unnamed Scene"}}{{/if}}</h1>
            <p>{{tr "Edit stage, titles, permissions, and actors directly inside the library."}}</p>
          </span>
        </header>

        <aside class="tom-scene-avatar-sidebar tom-theme-content-surface">
          <header class="tom-editor-header">
            <div>
              <h2>{{tr "Avatar Sidebar"}}</h2>
              <p class="notes">{{tr "{count} avatar(s) available directly in the scene editor." count=sceneEditorAvatarCount}}</p>
            </div>
          </header>

          <div class="tom-scene-avatar-sidebar__list">
            {{#if sceneEditorAvatarSidebarItems.length}}
              {{#each sceneEditorAvatarSidebarItems}}
              <article class="tom-scene-avatar-sidebar__item tom-theme-card" draggable="true" data-scene-editor-avatar="true" data-avatar-id="{{id}}">
                <div class="tom-avatar-thumb tom-scene-avatar-sidebar__thumb {{#if useCircularCrop}}is-circular{{/if}} {{#if showBackdrop}}has-backdrop{{/if}}" style="{{thumbnailStyle}}">
                  <div class="tom-avatar-thumb__image-stack">
                    {{#if thumbnail}}
                    <img src="{{thumbnail}}" alt="{{name}}" class="tom-avatar-thumb__image" />
                    {{else}}
                    <div class="tom-avatar-thumb__placeholder" aria-hidden="true">{{tr "Avatar"}}</div>
                    {{/if}}
                  </div>
                  {{#if frameImage}}
                  <img src="{{frameImage}}" alt="" class="tom-avatar-thumb__frame" aria-hidden="true" />
                  {{/if}}
                </div>

                <div class="tom-scene-avatar-sidebar__meta">
                  <strong>{{name}}</strong>
                  <p class="notes">{{actorName}}</p>
                </div>

                <div class="tom-scene-avatar-sidebar__actions">
                  <button
                    type="button"
                    class="tom-scene-avatar-sidebar__icon tom-button tom-button-ghost"
                    data-action="add-avatar-to-scene-editor"
                    data-avatar-id="{{id}}"
                    aria-label="{{tr "Add to scene"}}"
                    title="{{tr "To scene"}}"
                  >
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                  </button>
                </div>
              </article>
              {{/each}}
            {{else}}
            <div class="tom-empty-state tom-theme-card">
              <p>{{tr "No avatars available."}}</p>
            </div>
            {{/if}}
          </div>
        </aside>

        <div class="tom-scene-config-main">
          <section class="tom-theme-content-surface {{#if sceneEditorSectionSetupCollapsed}}is-collapsed{{else}}is-expanded{{/if}}" data-scene-editor-section="setup">
            <input type="hidden" name="sceneEditor.id" value="{{sceneEditor.id}}" />

            <button type="button" class="tom-editor-header tom-editor-header--toggle" data-action="toggle-scene-editor-section" data-scene-editor-section-key="setup" aria-expanded="{{#if sceneEditorSectionSetupCollapsed}}false{{else}}true{{/if}}">
              <div>
                <h2>{{tr "Scene Setup"}}</h2>
                <p class="notes">{{tr "Edit the stage, title, and overall mood for this scene directly in the library."}}</p>
              </div>
              <i class="fas {{#if sceneEditorSectionSetupCollapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}" aria-hidden="true"></i>
            </button>

            <div class="tom-scene-editor-section-body">
            <div class="tom-scene-config-setup-grid">
              <div class="tom-scene-config-headings">
                <div class="form-group tom-scene-config-headings__field">
                  <label>{{tr "Name"}}</label>
                  <input type="text" name="sceneEditor.name" value="{{sceneEditor.name}}" required />
                </div>

                <div class="form-group">
                  <label>{{tr "Stage title"}}</label>
                  <input type="text" name="sceneEditor.stageTitle" value="{{sceneEditor.stageTitle}}" placeholder="{{tr "Chapter 01"}}" />
                </div>

                <div class="form-group">
                  <label>{{tr "Subtitle"}}</label>
                  <input type="text" name="sceneEditor.stageSubtitle" value="{{sceneEditor.stageSubtitle}}" placeholder="{{tr "Location, mood, or free text"}}" />
                </div>

                <div class="form-group">
                  <label>{{tr "Description"}}</label>
                  <textarea name="sceneEditor.description" rows="4" placeholder="{{tr "Short description of this scene"}}">{{sceneEditor.description}}</textarea>
                </div>

                <div class="form-group">
                  <label>{{tr "Location"}}</label>
                  <input type="text" name="sceneEditor.location" value="{{sceneEditor.location}}" placeholder="{{tr "e.g. Frostpeaks Region"}}" />
                </div>

                <div class="form-group">
                  <label>{{tr "Tags"}}</label>
                  <input type="text" name="sceneEditor.tagsInput" value="{{sceneEditorTagsValue}}" placeholder="{{tr "Separate tags with commas"}}" />
                </div>
              </div>

              <div class="tom-scene-config-settings-grid">
                <section class="tom-scene-config-settings-card tom-scene-config-settings-card--background tom-theme-card">
                  <header class="tom-scene-config-settings-card__header">
                    <h3>{{tr "Background"}}</h3>
                    <p class="notes">{{tr "Set the image or video for the active Footlights scene."}}</p>
                  </header>

                  <div class="form-group">
                    <label>{{tr "Media path"}}</label>
                    <div class="tom-input-with-button">
                      <input type="text" name="sceneEditor.background" value="{{sceneEditor.background}}" placeholder="{{tr "Path to PNG/WebP/JPG/WEBM/MP4"}}" />
                      <button
                        type="button"
                        class="tom-button tom-button-ghost tom-button-compact"
                        data-action="pick-image"
                        data-target="[name='sceneEditor.background']"
                        data-picker-type="imagevideo"
                        aria-label="{{tr "Choose background media"}}"
                      >
                        <i class="fas fa-folder-open" aria-hidden="true"></i>
                        <span>{{tr "Browse"}}</span>
                      </button>
                    </div>
                  </div>

                  <div class="form-group">
                    <label>{{tr "Fallback thumbnail"}}</label>
                    <div class="tom-input-with-button">
                      <input type="text" name="sceneEditor.thumbnail" value="{{sceneEditor.thumbnail}}" placeholder="{{tr "Path to PNG/WebP/JPG"}}" />
                      <button
                        type="button"
                        class="tom-button tom-button-ghost tom-button-compact"
                        data-action="pick-image"
                        data-target="[name='sceneEditor.thumbnail']"
                        data-picker-type="image"
                        aria-label="{{tr "Choose fallback thumbnail"}}"
                      >
                        <i class="fas fa-folder-open" aria-hidden="true"></i>
                        <span>{{tr "Browse"}}</span>
                      </button>
                    </div>
                  </div>

                <div class="tom-scene-config-toggle-list">
                  <label class="tom-toggle-switch tom-scene-config-toggle-card {{#if sceneEditor.settings.boxed}}is-checked{{/if}}">
                    <input type="checkbox" name="sceneEditor.settings.boxed" {{checked sceneEditor.settings.boxed}} />
                    <span class="tom-toggle-switch__label">{{tr "Boxed"}}</span>
                    <span class="tom-toggle-switch__track" aria-hidden="true"><span class="tom-toggle-switch__knob"></span></span>
                  </label>
                  <div class="form-group tom-scene-config-fullscreen-fit {{#if sceneEditor.settings.boxed}}is-hidden{{/if}}">
                    <label>{{tr "Fullscreen fit"}}</label>
                    <select name="sceneEditor.settings.backgroundFullscreenFit">
                      {{selectOptions sceneEditorBackgroundFullscreenFitOptions selected=sceneEditor.settings.backgroundFullscreenFit}}
                    </select>
                  </div>
                  <label class="tom-toggle-switch tom-scene-config-toggle-card {{#if sceneEditor.settings.preserveBackgroundAspect}}is-checked{{/if}}">
                    <input type="checkbox" name="sceneEditor.settings.preserveBackgroundAspect" {{checked sceneEditor.settings.preserveBackgroundAspect}} />
                    <span class="tom-toggle-switch__label">{{tr "Preserve aspect ratio"}}</span>
                    <span class="tom-toggle-switch__track" aria-hidden="true"><span class="tom-toggle-switch__knob"></span></span>
                  </label>
                </div>

                <div class="form-group">
                  <label>{{tr "Cinematic"}}</label>
                  <select name="sceneEditor.settings.cinematicBars">
                    {{selectOptions sceneEditorCinematicOptions selected=sceneEditor.settings.cinematicBars}}
                  </select>
                </div>
              </section>

                <section class="tom-scene-config-settings-card tom-theme-card">
                  <header class="tom-scene-config-settings-card__header">
                    <h3>{{tr "Gameplay"}}</h3>
                    <p class="notes">{{tr "Controls visibility, mood access, and display behavior for the scene."}}</p>
                  </header>

                  <div class="tom-scene-config-toggle-list">
                    <label class="tom-toggle-switch tom-scene-config-toggle-card {{#if sceneEditor.settings.uiHidden}}is-checked{{/if}}">
                      <input type="checkbox" name="sceneEditor.settings.uiHidden" {{checked sceneEditor.settings.uiHidden}} />
                      <span class="tom-toggle-switch__label">{{tr "Hide UI for all clients"}}</span>
                      <span class="tom-toggle-switch__track" aria-hidden="true"><span class="tom-toggle-switch__knob"></span></span>
                    </label>

                    <label class="tom-toggle-switch tom-scene-config-toggle-card {{#if sceneEditor.settings.allowPlayerMoodChange}}is-checked{{/if}}">
                      <input type="checkbox" name="sceneEditor.settings.allowPlayerMoodChange" {{checked sceneEditor.settings.allowPlayerMoodChange}} />
                      <span class="tom-toggle-switch__label">{{tr "Players may change their own moods"}}</span>
                      <span class="tom-toggle-switch__track" aria-hidden="true"><span class="tom-toggle-switch__knob"></span></span>
                    </label>
                  </div>

                  <div class="form-group">
                    <label>{{tr "Mood display"}}</label>
                    <select name="sceneEditor.settings.moodDisplayMode">
                      {{selectOptions sceneEditorMoodDisplayModes selected=sceneEditor.settings.moodDisplayMode}}
                    </select>
                  </div>
                </section>

                <section class="tom-scene-config-settings-card tom-theme-card">
                  <header class="tom-scene-config-settings-card__header">
                    <h3>{{tr "Client sidebars"}}</h3>
                    <p class="notes">{{tr "Permissions for the left and right sidebar during the active scene."}}</p>
                  </header>

                  <div class="tom-scene-config-toggle-list">
                    <label class="tom-toggle-switch tom-scene-config-toggle-card {{#if sceneEditor.settings.sharedLeftSidebarVisible}}is-checked{{/if}}">
                      <input type="checkbox" name="sceneEditor.settings.sharedLeftSidebarVisible" {{checked sceneEditor.settings.sharedLeftSidebarVisible}} />
                      <span class="tom-toggle-switch__label">{{tr "Allow left sidebar for all clients"}}</span>
                      <span class="tom-toggle-switch__track" aria-hidden="true"><span class="tom-toggle-switch__knob"></span></span>
                    </label>

                    <label class="tom-toggle-switch tom-scene-config-toggle-card {{#if sceneEditor.settings.sharedRightSidebarVisible}}is-checked{{/if}}">
                      <input type="checkbox" name="sceneEditor.settings.sharedRightSidebarVisible" {{checked sceneEditor.settings.sharedRightSidebarVisible}} />
                      <span class="tom-toggle-switch__label">{{tr "Allow right sidebar for all clients"}}</span>
                      <span class="tom-toggle-switch__track" aria-hidden="true"><span class="tom-toggle-switch__knob"></span></span>
                    </label>
                  </div>
                </section>

                <section class="tom-scene-config-settings-card tom-theme-card">
                  <header class="tom-scene-config-settings-card__header">
                    <h3>{{tr "Sound Playlists"}}</h3>
                    <p class="notes">{{tr "Choose the playlists that should appear in this scene as the sound controls in the lower left."}}</p>
                  </header>

                  <div class="tom-scene-config-toggle-list">
                    {{#if sceneEditorSoundPlaylists.length}}
                      {{#each sceneEditorSoundPlaylists}}
                      <label class="tom-toggle-switch tom-scene-config-toggle-card {{#if isAssigned}}is-checked{{/if}}">
                        <input type="checkbox" name="sceneEditor.soundPlaylistAssignments" value="{{id}}" {{checked isAssigned}} />
                        <span class="tom-toggle-switch__label">{{name}} <small class="notes">({{tr "{trackCount} tracks, {soundboardCount} sounds" trackCount=trackCount soundboardCount=soundboardCount}})</small></span>
                        <span class="tom-toggle-switch__track" aria-hidden="true"><span class="tom-toggle-switch__knob"></span></span>
                      </label>
                      {{/each}}
                    {{else}}
                    <div class="tom-empty-state tom-theme-card">
                      <p>{{tr "No sound playlists available yet."}}</p>
                    </div>
                    {{/if}}
                  </div>
                </section>
              </div>
            </div>
            </div>
          </section>

          <section class="tom-theme-content-surface tom-scene-background-surface {{#if sceneEditorSectionBackgroundCollapsed}}is-collapsed{{else}}is-expanded{{/if}}" data-scene-editor-section="background">
            <button type="button" class="tom-editor-header tom-editor-header--toggle" data-action="toggle-scene-editor-section" data-scene-editor-section-key="background" aria-expanded="{{#if sceneEditorSectionBackgroundCollapsed}}false{{else}}true{{/if}}">
              <div>
                <h2>{{tr "Background Setup"}}</h2>
                <p class="notes">{{tr "Controls the large backdrop area behind the stage for GM and players."}}</p>
              </div>
              <i class="fas {{#if sceneEditorSectionBackgroundCollapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}" aria-hidden="true"></i>
            </button>

            <div class="tom-scene-editor-section-body tom-scene-transition-grid tom-scene-transition-grid--stacked">
              <section class="tom-scene-config-settings-card tom-theme-card tom-scene-config-settings-card--background">
                <header class="tom-scene-config-settings-card__header">
                  <h3>{{tr "Backdrop"}}</h3>
                  <p class="notes">{{tr "Optional background image behind the stage with blur, tiling, and dimming options."}}</p>
                </header>

                <div class="tom-scene-config-toggle-list">
                  <label class="tom-toggle-switch tom-scene-config-toggle-card {{#if sceneEditor.settings.backdropBlurEnabled}}is-checked{{/if}}">
                    <input type="checkbox" name="sceneEditor.settings.backdropBlurEnabled" {{checked sceneEditor.settings.backdropBlurEnabled}} />
                    <span class="tom-toggle-switch__label">{{tr "Enable blur"}}</span>
                    <span class="tom-toggle-switch__track" aria-hidden="true"><span class="tom-toggle-switch__knob"></span></span>
                  </label>
                </div>

                <div class="form-group">
                  <label>{{tr "Background image"}}</label>
                  <div class="tom-input-with-button">
                    <input type="text" name="sceneEditor.settings.backdropImage" value="{{sceneEditor.settings.backdropImage}}" placeholder="{{tr "Path to PNG/WebP/JPG"}}" />
                    <button
                      type="button"
                      class="tom-button tom-button-ghost tom-button-compact"
                      data-action="pick-image"
                      data-target="[name='sceneEditor.settings.backdropImage']"
                      data-picker-type="image"
                      aria-label="{{tr "Choose backdrop image"}}"
                    >
                      <i class="fas fa-folder-open" aria-hidden="true"></i>
                      <span>{{tr "Browse"}}</span>
                    </button>
                  </div>
                </div>

                <div class="form-group">
                  <label>{{tr "Image scale"}}</label>
                  <div class="tom-range-with-value">
                    <input type="range" min="0.1" max="4" step="0.05" name="sceneEditor.settings.backdropImageScale" value="{{sceneEditor.settings.backdropImageScale}}" data-range-display-suffix="x" />
                    <span>{{sceneEditor.settings.backdropImageScale}}x</span>
                  </div>
                </div>

                <div class="form-group">
                  <label>{{tr "Tiling"}}</label>
                  <select name="sceneEditor.settings.backdropImageRepeat">
                    {{selectOptions themeImageRepeatOptions selected=sceneEditor.settings.backdropImageRepeat}}
                  </select>
                </div>

                <div class="form-group">
                  <label>{{tr "Dim"}}</label>
                  <div class="tom-range-with-value">
                    <input type="range" min="0" max="0.92" step="0.02" name="sceneEditor.settings.backdropDarkness" value="{{sceneEditor.settings.backdropDarkness}}" />
                    <span>{{sceneEditor.settings.backdropDarkness}}</span>
                  </div>
                </div>
              </section>
            </div>
          </section>

          <section class="tom-theme-content-surface tom-scene-transition-surface {{#if sceneEditorSectionTransitionCollapsed}}is-collapsed{{else}}is-expanded{{/if}}" data-scene-editor-section="transition">
            <button type="button" class="tom-editor-header tom-editor-header--toggle" data-action="toggle-scene-editor-section" data-scene-editor-section-key="transition" aria-expanded="{{#if sceneEditorSectionTransitionCollapsed}}false{{else}}true{{/if}}">
              <div>
                <h2>{{tr "Transition Effects"}}</h2>
                <p class="notes">{{tr "Define for each scene how the transition to the next active Footlights scene should be staged."}}</p>
              </div>
              <i class="fas {{#if sceneEditorSectionTransitionCollapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}" aria-hidden="true"></i>
            </button>

            <div class="tom-scene-editor-section-body tom-scene-transition-grid">
              <section class="tom-scene-config-settings-card tom-theme-card">
                <header class="tom-scene-config-settings-card__header">
                  <h3>{{tr "Effect"}}</h3>
                  <p class="notes">{{sceneEditorSelectedTransitionOption.description}}</p>
                </header>

                <div class="form-group">
                  <label>{{tr "Transition type"}}</label>
