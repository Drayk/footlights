                <span class="tom-sound-library-action-divider" aria-hidden="true"></span>
                <button type="button" data-action="delete-sound-playlist" data-playlist-id="{{id}}" class="tom-button tom-sound-library-action tom-sound-library-action--delete" title="{{tr "Delete playlist"}}" aria-label="{{tr "Delete playlist"}}">
                  <i class="fas fa-trash-can" aria-hidden="true"></i>
                </button>
              </div>
            </article>
            {{/each}}
          </div>
          {{else}}
          <div class="tom-sound-library-empty tom-theme-card">
            <i class="fas fa-music" aria-hidden="true"></i>
            <h3>{{tr "No sound playlists found"}}</h3>
            <p class="notes">{{tr "Create a playlist to manage music and soundboards for Footlights scenes."}}</p>
