          <span class="tom-planner-library-hero__icon" aria-hidden="true">
            <i class="fas fa-diagram-project"></i>
          </span>
          <span>
            <h1>{{tr "Adventure Planner"}}</h1>
            <p class="notes">{{tr "Boards for adventure planning, relationships, and Foundry documents."}}</p>
          </span>
        </header>

        <section class="tom-planner-library-list" aria-label="{{tr "Adventure Planner"}}">
          {{#if planners.length}}
