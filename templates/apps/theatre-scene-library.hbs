                  <span aria-hidden="true" class="tom-sound-library-item__dot"></span>
                  <span><strong>{{soundboardCount}}</strong> {{tr "Soundboard(s)"}}</span>
                  <span aria-hidden="true" class="tom-sound-library-item__dot"></span>
                  <span><strong>{{sceneCount}}</strong> {{tr "Scene assignment(s)"}}</span>
