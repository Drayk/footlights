                <button type="button" data-action="add-stage-goblin-entry" data-stage-goblin-type="soundPlaylist" data-stage-goblin-id="{{id}}" data-stage-goblin-label="{{name}}" class="tom-button tom-sound-library-action" title="{{tr "Add to StageGoblin"}}" aria-label="{{tr "Add to StageGoblin"}}">
