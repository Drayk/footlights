              {{else}}
              <div class="tom-empty-state tom-theme-card">
                <p>{{tr "No actors in this Footlights scene yet."}}</p>
              </div>
              {{/if}}
            </div>
            </div>
          </section>
        </div>
      </div>
      {{else}}
      <section class="tom-library-inline-editor tom-library-inline-editor--frameless tom-scene-library-layout">
        <header class="tom-scene-library-hero">
