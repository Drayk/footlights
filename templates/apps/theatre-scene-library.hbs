                <summary class="tom-avatar-accordion__summary">
                  <span class="tom-avatar-accordion__title-row">
                    <span class="tom-avatar-accordion__icon" aria-hidden="true">
                      <i class="fas fa-user-tag"></i>
                    </span>
                    <span>
                      <span class="tom-avatar-accordion__title">{{tr "Identity"}}</span>
                      <span class="tom-avatar-accordion__description">{{tr "Name and linked actor for this avatar."}}</span>
