                  <i class="fas fa-pen-to-square" aria-hidden="true"></i>
                </button>
                <button type="button" data-action="duplicate-scene" data-scene-id="{{id}}" class="tom-button tom-button-icon tom-library-action tom-library-action--duplicate" title="{{tr "Duplicate scene"}}" aria-label="{{tr "Duplicate scene"}}">
                  <i class="fas fa-clone" aria-hidden="true"></i>
                </button>
                {{#if isActive}}
                <button type="button" data-action="deactivate-scene" class="tom-button tom-button-icon tom-library-action tom-library-action--play" title="{{tr "Deactivate scene"}}" aria-label="{{tr "Deactivate scene"}}">
                  <i class="fas fa-circle-stop" aria-hidden="true"></i>
