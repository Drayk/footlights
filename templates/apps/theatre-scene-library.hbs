            <i class="fas fa-diagram-project" aria-hidden="true"></i>
            <h3>{{tr "No Adventure Planners found"}}</h3>
            <p class="notes">{{tr "Create a planner to organize story beats, documents, and relationships."}}</p>
          </div>
          {{/if}}
        </section>
      </section>
      {{/if}}
    {{/if}}

    {{#if isPortalsTab}}
    {{#if isPortalEditorActive}}
    <section class="tom-library-inline-editor tom-library-inline-editor--frameless tom-portal-edit-layout">
      <header class="tom-portal-library-hero">
        <span class="tom-portal-library-hero__icon" aria-hidden="true">
          <i class="fas fa-door-open"></i>
        </span>
        <span>
          <h1>{{tr "Portal Configuration"}}</h1>
          <p class="notes">{{tr "Set up the portal background, thumbnail, and fullscreen behavior."}}</p>
        </span>
      </header>

      <div class="tom-portal-edit-grid">
        <section class="tom-portal-edit-card tom-portal-edit-card--preview tom-theme-card">
          <div class="tom-portal-edit-card__head">
            <h2>{{tr "Portal Canvas"}}</h2>
            <p class="notes">{{tr "Right-click the canvas to create elements. Drag unlocked elements to position them."}}</p>
          </div>
          <div class="tom-portal-editor-canvas-tools">
            <label class="tom-toggle-switch {{#if portalEditorShowGrid}}is-checked{{/if}}">
              <input type="checkbox" name="portalEditor.settings.showGridByDefault" {{#if portalEditorShowGrid}}checked{{/if}} />
              <span class="tom-toggle-switch__label">{{tr "Grid"}}</span>
              <span class="tom-toggle-switch__track" aria-hidden="true"><span class="tom-toggle-switch__knob"></span></span>
            </label>
            <label class="tom-toggle-switch {{#if portalEditorSnapToGrid}}is-checked{{/if}}">
              <input type="checkbox" name="portalEditor.settings.snapToGrid" {{#if portalEditorSnapToGrid}}checked{{/if}} />
              <span class="tom-toggle-switch__label">{{tr "Snap"}}</span>
              <span class="tom-toggle-switch__track" aria-hidden="true"><span class="tom-toggle-switch__knob"></span></span>
            </label>
            <label class="tom-toggle-switch {{#if portalEditorShowObjectFrames}}is-checked{{/if}}">
              <input type="checkbox" data-action="toggle-portal-editor-object-frames" {{#if portalEditorShowObjectFrames}}checked{{/if}} />
              <span class="tom-toggle-switch__label">{{tr "Object frames"}}</span>
              <span class="tom-toggle-switch__track" aria-hidden="true"><span class="tom-toggle-switch__knob"></span></span>
            </label>
            <label class="tom-portal-editor-tool-card">
              <span class="tom-portal-editor-tool-card__label">{{tr "Grid size"}}</span>
              <input type="number" name="portalEditor.settings.gridSize" value="{{portalEditorGridSize}}" min="4" max="200" step="1" />
            </label>
            <div class="tom-portal-editor-tool-card tom-portal-editor-zoom-card" title="{{tr "Mouse wheel zooms the portal editor canvas."}}">
              <span class="tom-portal-editor-tool-card__label">{{tr "Zoom"}}</span>
              <span class="tom-portal-editor-zoom-card__value" data-portal-editor-zoom-label>{{portalEditorZoomPercent}}</span>
            </div>
            <span class="tom-portal-editor-tools__spacer" aria-hidden="true"></span>
            <button type="button" class="tom-button tom-button-danger tom-button-icon tom-portal-editor-toolbar-action" data-action="cancel-portal-editor" aria-label="{{tr "Cancel editing"}}" title="{{tr "Cancel"}}">
              <i class="fas fa-xmark" aria-hidden="true"></i>
            </button>
            <button type="button" class="tom-button tom-button-success tom-button-icon tom-library-safe-button tom-portal-editor-toolbar-action" data-action="save-portal-editor" aria-label="{{tr "Save portal"}}" title="{{tr "Save"}}">
              <i class="fas fa-save" aria-hidden="true"></i>
            </button>
          </div>
          <div class="tom-portal-edit-preview tom-portal-editor-canvas {{#if portalEditorShowGrid}}has-grid{{/if}} {{#if portalEditorShowObjectFrames}}show-object-frames{{/if}}" data-portal-editor-canvas style="--tom-portal-editor-grid-size:{{portalEditorGridSize}}px; --tom-portal-editor-zoom:{{portalEditorZoom}}; --tom-portal-editor-pan-x:{{portalEditorPanX}}px; --tom-portal-editor-pan-y:{{portalEditorPanY}}px;">
            <div class="tom-portal-editor-surface {{#if isPortalEditorSurfaceOverrideEnabled}}is-override-surface{{/if}} {{#if isPortalEditorCropMode}}is-crop-editing{{/if}}" data-portal-editor-surface {{#if portalEditorSurfaceAspect}}data-portal-surface-aspect="{{portalEditorSurfaceAspect}}" data-portal-surface-override="true"{{/if}} data-portal-background-fit="{{portalEditor.settings.backgroundFit}}">
              {{#if portalEditor.background}}
              <div class="tom-portal-editor-canvas__background-clip">
                {{#if isPortalEditorVideoBackground}}
                <video class="tom-portal-editor-canvas__background" src="{{portalEditor.background}}" autoplay loop muted playsinline style="{{portalEditorBackgroundMediaStyle}}"></video>
                {{else if isPortalEditorBackgroundRepeated}}
                <img class="tom-portal-editor-canvas__background-probe" src="{{portalEditor.background}}" alt="" aria-hidden="true" />
                <div class="tom-portal-editor-canvas__background tom-portal-editor-canvas__background--pattern" style="{{portalEditorBackgroundMediaStyle}}"></div>
                {{else}}
                <img class="tom-portal-editor-canvas__background" src="{{portalEditor.background}}" alt="" style="{{portalEditorBackgroundMediaStyle}}" />
                {{/if}}
              </div>
              {{else}}
              <div class="tom-portal-editor-canvas__empty">
                <i class="fas fa-door-open" aria-hidden="true"></i>
                <span>{{tr "Choose a background to preview the portal."}}</span>
              </div>
              {{/if}}

              {{#each portalEditorElements}}
              <button
                type="button"
                class="tom-portal-editor-element tom-portal-editor-element--{{type}} {{#if isPortalAvatar}}is-portal-avatar{{/if}} {{#if isSelected}}is-selected{{/if}} {{#if locked}}is-locked{{/if}} {{#unless visible}}is-layer-hidden{{/unless}} {{#if isPreviewingEffects}}is-previewing-effects{{/if}} {{#if isEmptyObject}}is-empty-object{{/if}}"
                data-portal-editor-element-id="{{id}}"
                style="{{styleString}}"
                title="{{label}}"
              >
                <span class="tom-portal-editor-element__visual" style="{{visualStyleString}}">
                  <span class="tom-portal-editor-element__backdrop-effect" aria-hidden="true"></span>
                  {{#if isPortalAvatar}}
                    <span class="tom-avatar-thumb tom-portal-avatar-element {{#if avatar.useCircularCrop}}is-circular{{/if}} {{#if avatar.showBackdrop}}has-backdrop{{/if}}" style="{{avatar.thumbnailStyle}}">
                      <span class="tom-avatar-thumb__image-stack" style="{{avatar.imageStackStyle}}">
                        {{#if avatar.thumbnail}}
                        <img src="{{avatar.thumbnail}}" alt="{{avatar.name}}" class="tom-avatar-thumb__image" />
                        {{else}}
                        <span class="tom-avatar-thumb__placeholder" aria-hidden="true">{{tr "Avatar"}}</span>
                        {{/if}}
                      </span>
                      {{#if avatar.frameImage}}
                      <img src="{{avatar.frameImage}}" alt="" class="tom-avatar-thumb__frame" aria-hidden="true" />
                      {{/if}}
                    </span>
                  {{else}}
                    {{#if contentLayers.length}}
                      {{#each contentLayers}}
                      {{#if visible}}
                      <span class="tom-portal-content-layer tom-portal-content-layer--{{type}}" data-portal-content-layer-id="{{id}}" style="{{layerStyle}}">
                        <span class="tom-portal-content-layer__effect-target">
                        {{#if isImage}}
                          {{#if isRepeatedImage}}
                          {{else if hasMedia}}<img src="{{media.src}}" alt="" style="object-fit:{{mediaFit}};" />{{else}}<i class="fas fa-image" aria-hidden="true"></i>{{/if}}
                        {{else if isVideo}}
                          {{#if hasMedia}}<video src="{{media.src}}" autoplay loop muted playsinline style="object-fit:{{mediaFit}};"></video>{{else}}<i class="fas fa-film" aria-hidden="true"></i>{{/if}}
                        {{else if isPortalAvatar}}
                          <span class="tom-portal-avatar-layer">
                            {{#if avatar.thumbnail}}
                            <img src="{{avatar.thumbnail}}" alt="{{avatar.name}}" />
                            {{else}}
                            <span class="tom-avatar-thumb__placeholder" aria-hidden="true">{{tr "Avatar"}}</span>
                            {{/if}}
                          </span>
                        {{else if isDataText}}
                          <span class="tom-portal-content-layer__text">{{{escapedText}}}</span>
                        {{else if isText}}
                          <span class="tom-portal-content-layer__text">{{{escapedText}}}</span>
                        {{else if isHtml}}
                          <style data-portal-custom-css>{{{scopedCss}}}</style>
                          <span class="tom-portal-content-layer__html">{{{customHtml}}}</span>
                        {{/if}}
                        </span>
                      </span>
                      {{/if}}
                      {{/each}}
                    {{else if isShape}}
                      <i class="fas fa-square" aria-hidden="true"></i>
                    {{else}}
                      <i class="fas fa-object-group" aria-hidden="true"></i>
                    {{/if}}
                  {{/if}}
                </span>
                <span class="tom-portal-editor-element__resize" data-portal-resize-handle aria-hidden="true"></span>
              </button>
              {{/each}}

              {{#if portalEditorContextMenu}}
              <div class="tom-portal-editor-context-menu" style="left:{{portalEditorContextMenu.x}}px; top:{{portalEditorContextMenu.y}}px; --tom-portal-context-menu-inverse-scale:{{portalEditorContextMenu.inverseScale}};" data-portal-context-client-x="{{portalEditorContextMenu.clientX}}" data-portal-context-client-y="{{portalEditorContextMenu.clientY}}">
              <button type="button" data-action="portal-context-menu-action" data-portal-menu-action="create-object">
                <i class="fas fa-object-group" aria-hidden="true"></i><span>{{tr "Create Object"}}</span>
              </button>
              {{#if portalEditorContextMenu.elementId}}
              <span aria-hidden="true"></span>
              <button type="button" data-action="portal-context-menu-action" data-portal-menu-action="edit">
                <i class="fas fa-pen-to-square" aria-hidden="true"></i><span>{{tr "Edit"}}</span>
              </button>
              <button type="button" data-action="portal-context-menu-action" data-portal-menu-action="duplicate">
                <i class="fas fa-clone" aria-hidden="true"></i><span>{{tr "Duplicate"}}</span>
              </button>
              <button type="button" data-action="portal-context-menu-action" data-portal-menu-action="front">
                <i class="fas fa-angles-up" aria-hidden="true"></i><span>{{tr "Bring to front"}}</span>
              </button>
              <button type="button" data-action="portal-context-menu-action" data-portal-menu-action="back">
                <i class="fas fa-angles-down" aria-hidden="true"></i><span>{{tr "Send to back"}}</span>
              </button>
              <button type="button" data-action="portal-context-menu-action" data-portal-menu-action="toggle-lock">
                <i class="fas fa-lock" aria-hidden="true"></i><span>{{tr "Lock / Unlock"}}</span>
              </button>
              <button type="button" data-action="portal-context-menu-action" data-portal-menu-action="delete">
                <i class="fas fa-trash-can" aria-hidden="true"></i><span>{{tr "Delete"}}</span>
              </button>
              {{/if}}
              <button type="button" data-action="close-portal-context-menu">
                <i class="fas fa-xmark" aria-hidden="true"></i><span>{{tr "Close"}}</span>
              </button>
              </div>
              {{/if}}
              {{#if isPortalEditorCropMode}}
              <span class="tom-portal-crop-frame" data-portal-crop-frame aria-hidden="true">
                <span class="tom-portal-crop-handle tom-portal-crop-handle--n" data-portal-crop-handle="n"></span>
                <span class="tom-portal-crop-handle tom-portal-crop-handle--e" data-portal-crop-handle="e"></span>
                <span class="tom-portal-crop-handle tom-portal-crop-handle--s" data-portal-crop-handle="s"></span>
                <span class="tom-portal-crop-handle tom-portal-crop-handle--w" data-portal-crop-handle="w"></span>
              </span>
              {{/if}}
            </div>
          </div>
        </section>

        <aside class="tom-portal-editor-sidebar tom-theme-card">
          <div class="tom-portal-editor-sidebar__tabs" role="tablist" aria-label="{{tr "Portal editor sidebar"}}">
            <button
              type="button"
              class="tom-portal-editor-sidebar__tab {{#if isPortalEditorGeneralTab}}is-active{{/if}}"
              data-action="set-portal-sidebar-tab"
              data-portal-sidebar-tab="general"
              role="tab"
              aria-selected="{{#if isPortalEditorGeneralTab}}true{{else}}false{{/if}}"
            >
              {{tr "General"}}
            </button>
            <button
              type="button"
              class="tom-portal-editor-sidebar__tab {{#if isPortalEditorInspectorTab}}is-active{{/if}}"
              data-action="set-portal-sidebar-tab"
              data-portal-sidebar-tab="inspector"
              role="tab"
              aria-selected="{{#if isPortalEditorInspectorTab}}true{{else}}false{{/if}}"
            >
              {{tr "Inspector"}}
            </button>
            <button
              type="button"
              class="tom-portal-editor-sidebar__foundry-toggle {{#if isPortalEditorFoundryRightSidebarVisible}}is-active{{/if}}"
              data-action="toggle-portal-editor-foundry-right-sidebar"
              aria-pressed="{{#if isPortalEditorFoundryRightSidebarVisible}}true{{else}}false{{/if}}"
              aria-label="{{tr "Toggle Foundry sidebar"}}"
              title="{{tr "Toggle Foundry sidebar"}}"
            >
              <i class="fas fa-table-columns" aria-hidden="true"></i>
            </button>
          </div>

          <div class="tom-portal-editor-sidebar__pane tom-portal-editor-general" {{#unless isPortalEditorGeneralTab}}hidden{{/unless}}>
          <details class="tom-portal-edit-card tom-portal-editor-fieldset tom-portal-editor-fieldset--collapsible tom-theme-card" data-portal-editor-fieldset="general-elements" {{#if portalEditorFieldsets.generalElements}}open{{/if}}>
          <summary class="tom-portal-editor-fieldset__summary">
            <i class="fas fa-chevron-down" aria-hidden="true"></i>
            <h3>{{tr "Elements"}}</h3>
          </summary>
          <div class="tom-portal-edit-card__head">
            <p class="notes">{{tr "Select, duplicate, or delete portal objects."}}</p>
          </div>
          {{#if portalEditorElements.length}}
          <div class="tom-portal-editor-element-list">
            {{#each portalEditorElements}}
            <div class="tom-portal-editor-element-row {{#if isSelected}}is-selected{{/if}} {{#unless visible}}is-layer-hidden{{/unless}}">
              <button type="button" class="tom-portal-editor-element-row__select" data-action="select-portal-element" data-portal-element-id="{{id}}">
                <i class="fas {{#if isPortalAvatar}}fa-user{{else if isDataText}}fa-database{{else if isImage}}fa-image{{else if isVideo}}fa-film{{else if isText}}fa-font{{else if isShape}}fa-square{{else}}fa-object-group{{/if}}" aria-hidden="true"></i>
                <span>{{label}}</span>
              </button>
              <div class="tom-portal-editor-element-row__actions" aria-label="{{tr "Layer actions"}}">
                <button type="button" class="tom-portal-editor-layer-action" data-action="toggle-portal-element-visibility" data-portal-element-id="{{id}}" title="{{visibilityLabel}}" aria-label="{{visibilityLabel}}">
                  <i class="fas {{visibilityIcon}}" aria-hidden="true"></i>
                </button>
                <button type="button" class="tom-portal-editor-layer-action" data-action="duplicate-portal-element" data-portal-element-id="{{id}}" title="{{tr "Duplicate"}}" aria-label="{{tr "Duplicate"}}">
                  <i class="fas fa-clone" aria-hidden="true"></i>
                </button>
                <button type="button" class="tom-portal-editor-layer-action" data-action="portal-layer" data-layer-action="front" data-portal-element-id="{{id}}" title="{{tr "Bring to front"}}" aria-label="{{tr "Bring to front"}}">
                  <i class="fas fa-angles-up" aria-hidden="true"></i>
                </button>
                <button type="button" class="tom-portal-editor-layer-action is-danger" data-action="delete-portal-element" data-portal-element-id="{{id}}" title="{{tr "Delete"}}" aria-label="{{tr "Delete"}}">
                  <i class="fas fa-trash-can" aria-hidden="true"></i>
                </button>
              </div>
            </div>
            {{/each}}
          </div>
          {{else}}
          <div class="tom-portal-editor-empty">
            <i class="fas fa-arrow-pointer" aria-hidden="true"></i>
            <span>{{tr "No elements yet. Right-click the canvas to add one."}}</span>
          </div>
          {{/if}}
          </details>

          <details class="tom-portal-edit-card tom-portal-editor-fieldset tom-portal-editor-fieldset--collapsible tom-portal-edit-card--identity tom-theme-card" data-portal-editor-fieldset="general-identity" {{#if portalEditorFieldsets.generalIdentity}}open{{/if}}>
            <summary class="tom-portal-editor-fieldset__summary">
              <i class="fas fa-chevron-down" aria-hidden="true"></i>
              <h3>{{tr "Identity"}}</h3>
            </summary>
            <div class="tom-portal-edit-fields">
              <label class="form-group">
                <span>{{tr "Name"}}</span>
                <input type="text" name="portalEditor.name" value="{{portalEditor.name}}" />
              </label>
              <label class="form-group">
                <span>{{tr "Description"}}</span>
                <textarea name="portalEditor.description" rows="4">{{portalEditor.description}}</textarea>
              </label>
            </div>
          </details>

          <details class="tom-portal-edit-card tom-portal-editor-fieldset tom-portal-editor-fieldset--collapsible tom-portal-edit-card--assets tom-theme-card" data-portal-editor-fieldset="general-background" {{#if portalEditorFieldsets.generalBackground}}open{{/if}}>
            <summary class="tom-portal-editor-fieldset__summary">
              <i class="fas fa-chevron-down" aria-hidden="true"></i>
              <h3>{{tr "Background"}}</h3>
            </summary>
            <div class="tom-portal-edit-fields">
              <label class="form-group">
                <span>{{tr "Background type"}}</span>
                <select name="portalEditor.backgroundType">
                  {{#each portalEditorBackgroundTypeOptions}}
                  <option value="{{value}}" {{#if isSelected}}selected{{/if}}>{{label}}</option>
                  {{/each}}
                </select>
              </label>
              <div class="form-group">
                <label>{{tr "Background"}}</label>
                <div class="tom-input-with-button">
                  <input type="text" name="portalEditor.background" value="{{portalEditor.background}}" placeholder="{{tr "No background selected"}}" />
                  <button type="button" class="tom-button" data-action="pick-image" data-target="[name='portalEditor.background']" data-picker-type="imagevideo">
