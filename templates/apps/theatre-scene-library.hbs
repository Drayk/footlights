                  {{#if isActive}}
                  <button type="button" data-action="deactivate-scene" data-scene-id="{{id}}" class="tom-scene-library-action tom-scene-library-action--stop" title="{{tr "Stop scene"}}" aria-label="{{tr "Stop scene"}}">
                    <i class="fas fa-stop" aria-hidden="true"></i>
                  </button>
                  {{else}}
                  <button type="button" data-action="activate-scene" data-scene-id="{{id}}" class="tom-scene-library-action tom-scene-library-action--load" title="{{tr "Load scene"}}" aria-label="{{tr "Load scene"}}">
                    <i class="fas fa-circle-play" aria-hidden="true"></i>
                  </button>
                  {{/if}}
                  <button type="button" data-action="edit-scene" data-scene-id="{{id}}" class="tom-scene-library-action tom-scene-library-action--icon" title="{{tr "Edit scene"}}" aria-label="{{tr "Edit scene"}}">
                    <i class="fas fa-pen-to-square" aria-hidden="true"></i>
