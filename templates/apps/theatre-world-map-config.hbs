{{#unless inline}}
<form class="tom-world-map-config tom-map-editmode tom-theme-root tom-theme-area--content" style="{{themeInlineStyle}}">
{{/unless}}
{{#if inline}}
<div class="tom-world-map-config tom-world-map-config--inline tom-map-editmode tom-theme-root tom-theme-area--content" style="{{themeInlineStyle}}">
{{/if}}
  <input type="hidden" name="worldMap.id" value="{{map.id}}" />
  <input type="hidden" name="worldMap.tileRootPath" value="{{map.tileRootPath}}" />
  <input type="hidden" name="worldMap.tileUrlTemplate" value="{{map.tileUrlTemplate}}" />
  <input type="hidden" name="worldMap.manifestPath" value="{{map.manifestPath}}" />
  {{#each overlays}}
  <input type="hidden" name="worldMap.overlays.{{index}}.id" value="{{id}}" />
  <input type="hidden" name="worldMap.overlays.{{index}}.tileRootPath" value="{{tileRootPath}}" />
  <input type="hidden" name="worldMap.overlays.{{index}}.tileUrlTemplate" value="{{tileUrlTemplate}}" />
  <input type="hidden" name="worldMap.overlays.{{index}}.manifestPath" value="{{manifestPath}}" />
  {{/each}}
  {{#each categories}}
  <input type="hidden" name="worldMap.categories.{{index}}.id" value="{{id}}" />
  <input type="hidden" name="worldMap.categories.{{index}}.type" value="{{type}}" />
  <input type="hidden" name="worldMap.categories.{{index}}.iconClass" value="{{iconClass}}" />
  {{/each}}

  <header class="tom-map-editmode__hero">
    <span class="tom-map-editmode__hero-icon" aria-hidden="true">
      <i class="fas fa-map"></i>
    </span>
    <span class="tom-map-editmode__hero-copy">
      <strong>{{tr "Map Configuration"}}</strong>
      <small>{{tr "Structured setup for map media, fog, categories, styling, and zoom behavior."}}</small>
    </span>
  </header>

  <div class="tom-map-editmode__stack">
    <section class="tom-map-editmode__accordion {{#if sectionSetupCollapsed}}is-collapsed{{else}}is-expanded{{/if}}" data-world-map-config-section="setup">
      <button type="button" class="tom-map-editmode__accordion-toggle" data-action="toggle-map-config-section" data-world-map-config-section-key="setup" aria-expanded="{{#if sectionSetupCollapsed}}false{{else}}true{{/if}}">
        <span class="tom-map-editmode__section-icon" aria-hidden="true">
          <i class="fas fa-image"></i>
        </span>
        <span class="tom-map-editmode__section-copy">
          <strong>{{tr "World Map Setup"}}</strong>
          <small>{{tr "Simple workflow: choose a large image, generate tiles, then open the map."}}</small>
        </span>
        <i class="fas fa-chevron-right tom-map-editmode__chevron" aria-hidden="true"></i>
      </button>

      <div class="tom-map-editmode__accordion-body">
        <div class="tom-map-editmode__content-stack">
          <div class="tom-map-editmode__field-grid tom-map-editmode__field-grid--two">
            <label class="tom-map-editmode__field">
              <span>{{tr "Name"}}</span>
              <input type="text" name="worldMap.name" value="{{map.name}}" required />
            </label>
            <label class="tom-map-editmode__field">
              <span>{{tr "Description"}}</span>
              <input type="text" name="worldMap.description" value="{{map.description}}" />
            </label>
          </div>

          <div class="tom-map-editmode__content-stack tom-map-editmode__content-stack--tight">
            <label class="tom-map-editmode__field">
              <span>{{tr "Source image"}}</span>
              <span class="tom-map-editmode__file-row">
                <input type="text" name="worldMap.sourceImage" value="{{map.sourceImage}}" placeholder="{{tr "Path to PNG/WebP/JPG"}}" />
                <button type="button" class="tom-map-editmode__icon-button" data-action="pick-image" data-target="[name='worldMap.sourceImage']" data-picker-type="image" title="{{tr "Choose file"}}" aria-label="{{tr "Choose file"}}">
                  <i class="fas fa-folder-open" aria-hidden="true"></i>
                </button>
              </span>
            </label>
            <label class="tom-map-editmode__field">
              <span>{{tr "Thumbnail (optional)"}}</span>
              <span class="tom-map-editmode__file-row">
                <input type="text" name="worldMap.thumbnail" value="{{map.thumbnail}}" placeholder="{{tr "Path to PNG/WebP/JPG"}}" />
                <button type="button" class="tom-map-editmode__icon-button" data-action="pick-image" data-target="[name='worldMap.thumbnail']" data-picker-type="image" title="{{tr "Choose file"}}" aria-label="{{tr "Choose file"}}">
                  <i class="fas fa-folder-open" aria-hidden="true"></i>
                </button>
              </span>
            </label>
          </div>

          <section class="tom-map-editmode__subcard">
            <header class="tom-map-editmode__subcard-header">
              <span>
                <strong>{{tr "Overlays"}}</strong>
                <small>{{tr "Optional transparent overlays that match the base map dimensions exactly."}}</small>
              </span>
              <button type="button" class="tom-map-editmode__soft-action" data-action="add-map-overlay">
                <i class="fas fa-plus" aria-hidden="true"></i>
                <span>{{tr "Add overlay"}}</span>
              </button>
            </header>

            {{#if overlays.length}}
            <div class="tom-map-editmode__row-list">
              {{#each overlays}}
              <section class="tom-map-editmode__nested-card">
                <div class="tom-map-editmode__field-grid tom-map-editmode__field-grid--two">
                  <label class="tom-map-editmode__field">
                    <span>{{tr "Overlay name"}}</span>
                    <input type="text" name="worldMap.overlays.{{index}}.name" value="{{name}}" />
                  </label>
                  <label class="tom-map-editmode__field tom-map-editmode__field--short">
                    <span>{{tr "Opacity"}}</span>
                    <input type="number" min="0" max="1" step="0.05" name="worldMap.overlays.{{index}}.opacity" value="{{opacity}}" />
                  </label>
                </div>
                <label class="tom-map-editmode__field">
                  <span>{{tr "Overlay image"}}</span>
                  <span class="tom-map-editmode__file-row">
                    <input type="text" name="worldMap.overlays.{{index}}.sourceImage" value="{{sourceImage}}" placeholder="{{tr "Path to transparent PNG/WebP"}}" />
                    <button type="button" class="tom-map-editmode__icon-button" data-action="pick-image" data-target="[name='worldMap.overlays.{{index}}.sourceImage']" data-picker-type="image" title="{{tr "Choose file"}}" aria-label="{{tr "Choose file"}}">
                      <i class="fas fa-folder-open" aria-hidden="true"></i>
                    </button>
                  </span>
                </label>
                <footer class="tom-map-editmode__row-footer">
                  <label class="tom-map-editmode__toggle">
                    <input type="checkbox" name="worldMap.overlays.{{index}}.visibleByDefault" {{checked visibleByDefault}} />
                    <span>{{tr "Visible by default"}}</span>
                  </label>
                  <button type="button" class="tom-map-editmode__delete-button" data-action="remove-map-overlay" data-overlay-id="{{id}}">
                    <i class="fas fa-trash-can" aria-hidden="true"></i>
                    <span>{{tr "Remove overlay"}}</span>
                  </button>
                </footer>
              </section>
              {{/each}}
            </div>
            {{else}}
            <p class="tom-map-editmode__empty">{{tr "No overlays configured yet."}}</p>
            {{/if}}
          </section>

          <section class="tom-map-editmode__subcard">
            <header class="tom-map-editmode__subcard-header">
              <span>
                <strong>{{tr "Tile Generator"}}</strong>
                <small>{{tr "Generate tiles from the source image."}}</small>
              </span>
            </header>
            <div class="tom-map-editmode__generator-row">
              <label class="tom-map-editmode__field">
                <span>
                  {{tr "Tile size"}}
                  {{#if systemCritical.tileSize}}
                  <em class="tom-map-editmode__system-critical">({{tr "Attention: System critical"}} - {{tr "System"}}: {{systemCritical.tileSize}})</em>
                  {{/if}}
                </span>
                <select name="worldMap.tileSize">
                  {{#each tileSizeOptions}}
                  <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                  {{/each}}
                </select>
              </label>
              <button type="button" class="tom-map-editmode__generate-button {{#if tileProgress.running}}is-disabled{{/if}}" data-action="generate-map-tiles" {{#if tileProgress.running}}disabled{{/if}}>
                {{#if tileProgress.running}}{{tr "Generating..."}}{{else}}{{tr "Generate tiles from image"}}{{/if}}
              </button>
            </div>
            <div class="tom-map-editmode__status-row">
              <span><strong>{{tr "Status"}}:</strong> {{#if hasTiles}}{{tr "Ready"}}{{else}}{{tr "Draft"}}{{/if}}</span>
              <span class="tom-map-editmode__status-percent">{{tileProgress.percent}}%</span>
            </div>
            <p class="notes">{{tileProgress.message}}</p>
            <div class="tom-map-editmode__progress">
              <span style="width:{{tileProgress.percent}}%;"></span>
            </div>
          </section>
        </div>
      </div>
    </section>

    <section class="tom-map-editmode__accordion {{#if sectionFogCollapsed}}is-collapsed{{else}}is-expanded{{/if}}" data-world-map-config-section="fog">
      <button type="button" class="tom-map-editmode__accordion-toggle" data-action="toggle-map-config-section" data-world-map-config-section-key="fog" aria-expanded="{{#if sectionFogCollapsed}}false{{else}}true{{/if}}">
        <span class="tom-map-editmode__section-icon" aria-hidden="true">
          <i class="fas fa-cloud"></i>
        </span>
        <span class="tom-map-editmode__section-copy">
          <strong>{{tr "Fog of War"}}</strong>
          <small>{{tr "Cover the active map with editable fog that GMs can reveal or restore with drawing tools."}}</small>
        </span>
        <i class="fas fa-chevron-right tom-map-editmode__chevron" aria-hidden="true"></i>
      </button>

      <div class="tom-map-editmode__accordion-body">
        <div class="tom-map-editmode__content-stack">
          <label class="tom-map-editmode__toggle tom-map-editmode__toggle--full">
            <input type="checkbox" name="worldMap.fogSettings.enabled" {{checked map.fogSettings.enabled}} />
            <span>{{tr "Enable fog of war"}}</span>
          </label>

          <section class="tom-map-editmode__subcard">
            <header class="tom-map-editmode__subcard-header">
              <span>
                <strong>{{tr "Basic fog"}}</strong>
              </span>
            </header>
            <div class="tom-map-editmode__field-grid tom-map-editmode__field-grid--three">
              <label class="tom-map-editmode__field">
                <span>{{tr "Fog mode"}}</span>
                <select name="worldMap.fogSettings.mode">
                  {{selectOptions fogModeOptions selected=map.fogSettings.mode valueAttr="value" labelAttr="label"}}
                </select>
              </label>
              <label class="tom-map-editmode__field tom-map-editmode__field--short">
                <span>{{tr "Fog opacity"}}</span>
                <input type="number" min="0" max="1" step="0.05" name="worldMap.fogSettings.opacity" value="{{map.fogSettings.opacity}}" />
              </label>
              <label class="tom-map-editmode__field tom-map-editmode__color-field">
                <span>{{tr "Fog color"}}</span>
                <input class="tom-world-map-config__color-swatch" type="color" name="worldMap.fogSettings.color" value="{{map.fogSettings.color}}" />
              </label>
            </div>
          </section>

          <section class="tom-map-editmode__subcard">
            <header class="tom-map-editmode__subcard-header">
              <span>
                <strong>{{tr "Image fog"}}</strong>
                <small>{{tr "Images are rendered over the map and masked by the same reveal operations as the color fog."}}</small>
              </span>
            </header>
            <label class="tom-map-editmode__field">
              <span>{{tr "Fog image"}}</span>
              <span class="tom-map-editmode__file-row">
                <input type="text" name="worldMap.fogSettings.imagePath" value="{{map.fogSettings.imagePath}}" placeholder="{{tr "Path to PNG/WebP/JPG"}}" />
                <button type="button" class="tom-map-editmode__icon-button" data-action="pick-image" data-target="[name='worldMap.fogSettings.imagePath']" data-picker-type="image" title="{{tr "Choose file"}}" aria-label="{{tr "Choose file"}}">
                  <i class="fas fa-folder-open" aria-hidden="true"></i>
                </button>
              </span>
            </label>
            <div class="tom-map-editmode__divider"></div>
            <label class="tom-map-editmode__field">
              <span>{{tr "Fog image tile size"}}</span>
              <span class="tom-map-editmode__range-row tom-range-with-value">
                <input type="range" min="16" max="2048" step="8" name="worldMap.fogSettings.imageTileSize" value="{{map.fogSettings.imageTileSize}}" data-fog-image-tile-size />
                <strong data-fog-image-tile-size-value>{{map.fogSettings.imageTileSize}} px</strong>
              </span>
              <small>{{tr "Controls how large the fog image texture tiles are drawn."}}</small>
            </label>
            <div class="tom-map-editmode__toggle-grid">
              <label class="tom-map-editmode__toggle">
                <input type="checkbox" name="worldMap.fogSettings.imageTileFixedOnZoom" {{checked map.fogSettings.imageTileFixedOnZoom}} />
                <span>{{tr "Keep fog image tile size while zooming"}}</span>
              </label>
              <label class="tom-map-editmode__toggle">
                <input type="checkbox" name="worldMap.fogSettings.imageTileViewportLocked" {{checked map.fogSettings.imageTileViewportLocked}} />
                <span>{{tr "Lock fog image texture to viewport"}}</span>
              </label>
            </div>
          </section>
        </div>
      </div>
    </section>

    <section class="tom-map-editmode__accordion {{#if sectionCategoriesCollapsed}}is-collapsed{{else}}is-expanded{{/if}}" data-world-map-config-section="categories">
      <button type="button" class="tom-map-editmode__accordion-toggle" data-action="toggle-map-config-section" data-world-map-config-section-key="categories" aria-expanded="{{#if sectionCategoriesCollapsed}}false{{else}}true{{/if}}">
        <span class="tom-map-editmode__section-icon" aria-hidden="true">
          <i class="fas fa-tags"></i>
        </span>
        <span class="tom-map-editmode__section-copy">
          <strong>{{tr "Category Setup"}}</strong>
          <small>{{tr "Manage the shared selectable categories for every map element."}}</small>
        </span>
        <i class="fas fa-chevron-right tom-map-editmode__chevron" aria-hidden="true"></i>
      </button>

      <div class="tom-map-editmode__accordion-body">
        <section class="tom-map-editmode__subcard">
          <header class="tom-map-editmode__subcard-header">
            <span>
              <strong>{{tr "Categories"}}</strong>
              <small>{{tr "Shared categories for pins, lines, regions, images, and text objects."}}</small>
            </span>
            <span class="tom-map-editmode__header-actions">
              <button type="button" class="tom-map-editmode__icon-button tom-map-editmode__category-add-button" data-action="add-map-category-separator" title="{{tr "Add divider"}}" aria-label="{{tr "Add divider"}}">
                <i class="fas fa-grip-lines" aria-hidden="true"></i>
              </button>
              <button type="button" class="tom-map-editmode__icon-button tom-map-editmode__category-add-button" data-action="add-map-category" title="{{tr "Add category"}}" aria-label="{{tr "Add category"}}">
                <i class="fas fa-plus" aria-hidden="true"></i>
              </button>
            </span>
          </header>
          <div class="tom-map-editmode__category-list">
            {{#each categories}}
            {{#if isSeparator}}
            <section class="tom-map-editmode__category-row tom-map-editmode__category-row--separator" data-category-id="{{id}}">
              <button type="button" class="tom-map-editmode__category-drag-handle" draggable="true" data-action="drag-map-category" data-category-id="{{id}}" title="{{tr "Reorder divider"}}" aria-label="{{tr "Reorder divider"}}">
                <i class="fas fa-grip-vertical" aria-hidden="true"></i>
              </button>
              <span class="tom-map-editmode__category-separator-preview" style="--tom-map-category-separator-color: {{color}};" aria-hidden="true"></span>
              <input type="hidden" name="worldMap.categories.{{index}}.name" value="{{name}}" />
              <input class="tom-world-map-config__color-swatch" type="color" name="worldMap.categories.{{index}}.color" value="{{color}}" aria-label="{{tr "Divider color"}}" title="{{tr "Divider color"}}" />
              <button type="button" class="tom-map-editmode__delete-icon" data-action="remove-map-category" data-category-id="{{id}}" title="{{tr "Delete"}}" aria-label="{{tr "Delete"}}">
                <i class="fas fa-trash-can" aria-hidden="true"></i>
              </button>
            </section>
            {{else}}
            <section class="tom-map-editmode__category-row" data-category-id="{{id}}">
              <button type="button" class="tom-map-editmode__category-drag-handle" draggable="true" data-action="drag-map-category" data-category-id="{{id}}" title="{{tr "Reorder category"}}" aria-label="{{tr "Reorder category"}}">
                <i class="fas fa-grip-vertical" aria-hidden="true"></i>
              </button>
              <button type="button" class="tom-map-editmode__icon-button tom-map-editmode__category-icon" data-action="pick-map-category-icon" data-category-id="{{id}}" title="{{tr "Choose icon"}}" aria-label="{{tr "Choose icon"}}">
                <i class="fas {{iconClass}}" aria-hidden="true"></i>
              </button>
              <input type="text" name="worldMap.categories.{{index}}.name" value="{{name}}" aria-label="{{tr "Category"}}" />
              <input class="tom-world-map-config__color-swatch" type="color" name="worldMap.categories.{{index}}.color" value="{{color}}" aria-label="{{tr "Color"}}" title="{{tr "Color"}}" />
              <button type="button" class="tom-map-editmode__delete-icon" data-action="remove-map-category" data-category-id="{{id}}" title="{{tr "Delete"}}" aria-label="{{tr "Delete"}}">
                <i class="fas fa-trash-can" aria-hidden="true"></i>
              </button>
            </section>
            {{/if}}
            {{/each}}
          </div>
        </section>
      </div>
    </section>

    <section class="tom-map-editmode__accordion {{#if sectionFullscreenCollapsed}}is-collapsed{{else}}is-expanded{{/if}}" data-world-map-config-section="fullscreen">
      <button type="button" class="tom-map-editmode__accordion-toggle" data-action="toggle-map-config-section" data-world-map-config-section-key="fullscreen" aria-expanded="{{#if sectionFullscreenCollapsed}}false{{else}}true{{/if}}">
        <span class="tom-map-editmode__section-icon" aria-hidden="true">
          <i class="fas fa-desktop"></i>
        </span>
        <span class="tom-map-editmode__section-copy">
          <strong>{{tr "Full screen map Setup"}}</strong>
          <small>{{tr "Configure the Theatre-style fullscreen stage variant for this map."}}</small>
        </span>
        <i class="fas fa-chevron-right tom-map-editmode__chevron" aria-hidden="true"></i>
      </button>

      <div class="tom-map-editmode__accordion-body">
        <div class="tom-map-editmode__content-stack">
          <div class="tom-map-editmode__toggle-grid">
            <label class="tom-map-editmode__toggle">
              <input type="checkbox" name="worldMap.fullscreenSettings.preserveAspect" {{checked map.fullscreenSettings.preserveAspect}} />
              <span>{{tr "Preserve map aspect ratio"}}</span>
            </label>
            <label class="tom-map-editmode__toggle">
              <input type="checkbox" name="worldMap.fullscreenSettings.uiHidden" {{checked map.fullscreenSettings.uiHidden}} />
              <span>{{tr "Hide Foundry UI while the fullscreen map is open"}}</span>
            </label>
            <label class="tom-map-editmode__toggle">
              <input type="checkbox" name="worldMap.fullscreenSettings.sharedLeftSidebarVisible" {{checked map.fullscreenSettings.sharedLeftSidebarVisible}} />
              <span>{{tr "Allow left sidebar in fullscreen map"}}</span>
            </label>
            <label class="tom-map-editmode__toggle">
              <input type="checkbox" name="worldMap.fullscreenSettings.sharedRightSidebarVisible" {{checked map.fullscreenSettings.sharedRightSidebarVisible}} />
              <span>{{tr "Allow right sidebar in fullscreen map"}}</span>
            </label>
            <label class="tom-map-editmode__toggle">
              <input type="checkbox" name="worldMap.fullscreenSettings.backdropBlurEnabled" {{checked map.fullscreenSettings.backdropBlurEnabled}} />
              <span>{{tr "Enable blur"}}</span>
            </label>
          </div>

          <section class="tom-map-editmode__subcard">
            <header class="tom-map-editmode__subcard-header">
              <span>
                <strong>{{tr "Backdrop Image Settings"}}</strong>
                <small>{{tr "Configure the fullscreen stage background behind the map."}}</small>
              </span>
            </header>
            <label class="tom-map-editmode__field">
              <span>{{tr "Background image"}}</span>
              <span class="tom-map-editmode__file-row">
                <input type="text" name="worldMap.fullscreenSettings.backdropImage" value="{{map.fullscreenSettings.backdropImage}}" placeholder="{{tr "Path to PNG/WebP/JPG"}}" />
                <button type="button" class="tom-map-editmode__icon-button" data-action="pick-image" data-target="[name='worldMap.fullscreenSettings.backdropImage']" data-picker-type="image" title="{{tr "Choose file"}}" aria-label="{{tr "Choose file"}}">
                  <i class="fas fa-folder-open" aria-hidden="true"></i>
                </button>
              </span>
            </label>
            <div class="tom-map-editmode__field-grid tom-map-editmode__field-grid--three">
              <label class="tom-map-editmode__field">
                <span>{{tr "Image scale"}}</span>
                <input type="number" min="0.1" max="4" step="0.05" name="worldMap.fullscreenSettings.backdropImageScale" value="{{map.fullscreenSettings.backdropImageScale}}" />
              </label>
              <label class="tom-map-editmode__field">
                <span>{{tr "Tiling"}}</span>
                <select name="worldMap.fullscreenSettings.backdropImageRepeat">
                  {{selectOptions backdropRepeatOptions selected=map.fullscreenSettings.backdropImageRepeat valueAttr="value" labelAttr="label"}}
                </select>
              </label>
              <label class="tom-map-editmode__field">
                <span>{{tr "Dim background"}}</span>
                <input type="number" min="0" max="0.92" step="0.05" name="worldMap.fullscreenSettings.backdropDarkness" value="{{map.fullscreenSettings.backdropDarkness}}" />
              </label>
            </div>
          </section>
        </div>
      </div>
    </section>

    <section class="tom-map-editmode__accordion {{#if sectionStylingCollapsed}}is-collapsed{{else}}is-expanded{{/if}}" data-world-map-config-section="styling">
      <button type="button" class="tom-map-editmode__accordion-toggle" data-action="toggle-map-config-section" data-world-map-config-section-key="styling" aria-expanded="{{#if sectionStylingCollapsed}}false{{else}}true{{/if}}">
        <span class="tom-map-editmode__section-icon" aria-hidden="true">
          <i class="fas fa-palette"></i>
        </span>
        <span class="tom-map-editmode__section-copy">
          <strong>{{tr "Styling"}}</strong>
          <small>{{tr "Customize tooltip, legend, and pin list styling for this map only."}}</small>
        </span>
        <i class="fas fa-chevron-right tom-map-editmode__chevron" aria-hidden="true"></i>
      </button>

      <div class="tom-map-editmode__accordion-body">
        <div class="tom-map-editmode__content-stack">
          <section class="tom-map-editmode__subcard">
            <header class="tom-map-editmode__subcard-header">
              <span>
                <strong>{{tr "Tooltips"}}</strong>
                <small>{{tr "Styles active map tooltips, including journal-link info lines."}}</small>
              </span>
            </header>
            <div class="tom-map-editmode__field-grid tom-map-editmode__field-grid--three">
              <label class="tom-map-editmode__field tom-map-editmode__color-field">
                <span>{{tr "Background color"}}</span>
                <input class="tom-world-map-config__color-swatch" type="color" name="worldMap.styling.tooltip.backgroundColor" value="{{map.styling.tooltip.backgroundColor}}" />
              </label>
              <label class="tom-map-editmode__field">
                <span>{{tr "Background opacity"}}</span>
                <input type="number" min="0" max="1" step="0.05" name="worldMap.styling.tooltip.backgroundOpacity" value="{{map.styling.tooltip.backgroundOpacity}}" />
              </label>
              <label class="tom-map-editmode__toggle">
                <input type="checkbox" name="worldMap.styling.tooltip.blurEnabled" {{checked map.styling.tooltip.blurEnabled}} />
                <span>{{tr "Enable blur"}}</span>
              </label>
            </div>
          </section>

          <div class="tom-map-editmode__card-grid tom-map-editmode__card-grid--three">
            <section class="tom-map-editmode__subcard">
              <header class="tom-map-editmode__mini-header">
                <strong>{{tr "Tooltip heading"}}</strong>
              </header>
              <label class="tom-map-editmode__field">
                <span>{{tr "Font Type"}}</span>
                <select name="worldMap.styling.tooltip.headingFont">
                  {{selectOptions fontOptions selected=map.styling.tooltip.headingFont valueAttr="value" labelAttr="label"}}
                </select>
              </label>
              <div class="tom-map-editmode__field-grid tom-map-editmode__field-grid--two">
                <label class="tom-map-editmode__field tom-map-editmode__color-field">
                  <span>{{tr "Font color"}}</span>
                  <input class="tom-world-map-config__color-swatch" type="color" name="worldMap.styling.tooltip.headingColor" value="{{map.styling.tooltip.headingColor}}" />
                </label>
                <label class="tom-map-editmode__field tom-map-editmode__field--short">
                  <span>{{tr "Font size"}}</span>
                  <input type="number" min="0.5" max="2.4" step="0.05" name="worldMap.styling.tooltip.headingSize" value="{{map.styling.tooltip.headingSize}}" />
                </label>
              </div>
            </section>

            <section class="tom-map-editmode__subcard">
              <header class="tom-map-editmode__mini-header">
                <strong>{{tr "Tooltip text"}}</strong>
              </header>
              <label class="tom-map-editmode__field">
                <span>{{tr "Font Type"}}</span>
                <select name="worldMap.styling.tooltip.textFont">
                  {{selectOptions fontOptions selected=map.styling.tooltip.textFont valueAttr="value" labelAttr="label"}}
                </select>
              </label>
              <div class="tom-map-editmode__field-grid tom-map-editmode__field-grid--two">
                <label class="tom-map-editmode__field tom-map-editmode__color-field">
                  <span>{{tr "Font color"}}</span>
                  <input class="tom-world-map-config__color-swatch" type="color" name="worldMap.styling.tooltip.textColor" value="{{map.styling.tooltip.textColor}}" />
                </label>
                <label class="tom-map-editmode__field tom-map-editmode__field--short">
                  <span>{{tr "Font size"}}</span>
                  <input type="number" min="0.5" max="2.4" step="0.05" name="worldMap.styling.tooltip.textSize" value="{{map.styling.tooltip.textSize}}" />
                </label>
              </div>
            </section>

            <section class="tom-map-editmode__subcard">
              <header class="tom-map-editmode__mini-header">
                <strong>{{tr "Tooltip info"}}</strong>
              </header>
              <label class="tom-map-editmode__field">
                <span>{{tr "Font Type"}}</span>
                <select name="worldMap.styling.tooltip.infoFont">
                  {{selectOptions fontOptions selected=map.styling.tooltip.infoFont valueAttr="value" labelAttr="label"}}
                </select>
              </label>
              <div class="tom-map-editmode__field-grid tom-map-editmode__field-grid--two">
                <label class="tom-map-editmode__field tom-map-editmode__color-field">
                  <span>{{tr "Font color"}}</span>
                  <input class="tom-world-map-config__color-swatch" type="color" name="worldMap.styling.tooltip.infoColor" value="{{map.styling.tooltip.infoColor}}" />
                </label>
                <label class="tom-map-editmode__field tom-map-editmode__field--short">
                  <span>{{tr "Font size"}}</span>
                  <input type="number" min="0.5" max="2.4" step="0.05" name="worldMap.styling.tooltip.infoSize" value="{{map.styling.tooltip.infoSize}}" />
                </label>
              </div>
            </section>
          </div>

          <section class="tom-map-editmode__subcard">
            <header class="tom-map-editmode__subcard-header">
              <span>
                <strong>{{tr "General"}}</strong>
                <small>{{tr "Controls map-local typography for legends and the right sidebar pin list."}}</small>
              </span>
            </header>
            <div class="tom-map-editmode__card-grid tom-map-editmode__card-grid--two">
              <section class="tom-map-editmode__nested-card">
                <header class="tom-map-editmode__mini-header">
                  <strong>{{tr "Map legend"}}</strong>
                </header>
                <label class="tom-map-editmode__field">
                  <span>{{tr "Font Type"}}</span>
                  <select name="worldMap.styling.general.legendFont">
                    {{selectOptions fontOptions selected=map.styling.general.legendFont valueAttr="value" labelAttr="label"}}
                  </select>
                </label>
                <div class="tom-map-editmode__field-grid tom-map-editmode__field-grid--two">
                  <label class="tom-map-editmode__field tom-map-editmode__color-field">
                    <span>{{tr "Font color"}}</span>
                    <input class="tom-world-map-config__color-swatch" type="color" name="worldMap.styling.general.legendColor" value="{{map.styling.general.legendColor}}" />
                  </label>
                  <label class="tom-map-editmode__field tom-map-editmode__field--short">
                    <span>{{tr "Font size"}}</span>
                    <input type="number" min="0.45" max="1.6" step="0.05" name="worldMap.styling.general.legendSize" value="{{map.styling.general.legendSize}}" />
                  </label>
                </div>
              </section>

              <section class="tom-map-editmode__nested-card">
                <header class="tom-map-editmode__mini-header">
                  <strong>{{tr "Pin list"}}</strong>
                </header>
                <div class="tom-map-editmode__content-stack tom-map-editmode__content-stack--tight">
                  <label class="tom-map-editmode__field">
                    <span>{{tr "Pin list heading font"}}</span>
                    <select name="worldMap.styling.general.pinListHeadingFont">
                      {{selectOptions fontOptions selected=map.styling.general.pinListHeadingFont valueAttr="value" labelAttr="label"}}
                    </select>
                  </label>
                  <div class="tom-map-editmode__field-grid tom-map-editmode__field-grid--two">
                    <label class="tom-map-editmode__field tom-map-editmode__color-field">
                      <span>{{tr "Heading color"}}</span>
                      <input class="tom-world-map-config__color-swatch" type="color" name="worldMap.styling.general.pinListHeadingColor" value="{{map.styling.general.pinListHeadingColor}}" />
                    </label>
                    <label class="tom-map-editmode__field tom-map-editmode__field--short">
                      <span>{{tr "Heading size"}}</span>
                      <input type="number" min="0.5" max="2.4" step="0.05" name="worldMap.styling.general.pinListHeadingSize" value="{{map.styling.general.pinListHeadingSize}}" />
                    </label>
                  </div>
                  <label class="tom-map-editmode__field">
                    <span>{{tr "Pin list text font"}}</span>
                    <select name="worldMap.styling.general.pinListTextFont">
                      {{selectOptions fontOptions selected=map.styling.general.pinListTextFont valueAttr="value" labelAttr="label"}}
                    </select>
                  </label>
                  <div class="tom-map-editmode__field-grid tom-map-editmode__field-grid--two">
                    <label class="tom-map-editmode__field tom-map-editmode__color-field">
                      <span>{{tr "Text color"}}</span>
                      <input class="tom-world-map-config__color-swatch" type="color" name="worldMap.styling.general.pinListTextColor" value="{{map.styling.general.pinListTextColor}}" />
                    </label>
                    <label class="tom-map-editmode__field tom-map-editmode__field--short">
                      <span>{{tr "Text size"}}</span>
                      <input type="number" min="0.5" max="2.4" step="0.05" name="worldMap.styling.general.pinListTextSize" value="{{map.styling.general.pinListTextSize}}" />
                    </label>
                  </div>
                </div>
              </section>
            </div>
          </section>
        </div>
      </div>
    </section>

    <section class="tom-map-editmode__accordion {{#if sectionAdvancedCollapsed}}is-collapsed{{else}}is-expanded{{/if}}" data-world-map-config-section="advanced">
      <button type="button" class="tom-map-editmode__accordion-toggle" data-action="toggle-map-config-section" data-world-map-config-section-key="advanced" aria-expanded="{{#if sectionAdvancedCollapsed}}false{{else}}true{{/if}}">
        <span class="tom-map-editmode__section-icon" aria-hidden="true">
          <i class="fas fa-table-cells"></i>
        </span>
        <span class="tom-map-editmode__section-copy">
          <strong>{{tr "Advanced"}}</strong>
          <small>{{tr "Fine-tune map dimensions, zoom limits, and startup behavior."}}</small>
        </span>
        <i class="fas fa-chevron-right tom-map-editmode__chevron" aria-hidden="true"></i>
      </button>

      <div class="tom-map-editmode__accordion-body">
        <div class="tom-map-editmode__content-stack">
          <div class="tom-map-editmode__field-grid tom-map-editmode__field-grid--two">
            <label class="tom-map-editmode__field">
              <span>
                {{tr "Width"}}
                {{#if systemCritical.width}}
                <em class="tom-map-editmode__system-critical">({{tr "Attention: System critical"}} - {{tr "System"}}: {{systemCritical.width}})</em>
                {{/if}}
              </span>
              <input type="number" min="256" name="worldMap.width" value="{{map.width}}" />
            </label>
            <label class="tom-map-editmode__field">
              <span>
                {{tr "Height"}}
                {{#if systemCritical.height}}
                <em class="tom-map-editmode__system-critical">({{tr "Attention: System critical"}} - {{tr "System"}}: {{systemCritical.height}})</em>
                {{/if}}
              </span>
              <input type="number" min="256" name="worldMap.height" value="{{map.height}}" />
            </label>
          </div>

          <section class="tom-map-editmode__subcard">
            <header class="tom-map-editmode__subcard-header">
              <span>
                <strong>{{tr "Zoom & Coordinates"}}</strong>
                <small>{{tr "Startup view used when the map opens."}}</small>
              </span>
            </header>
            <div class="tom-map-editmode__field-grid tom-map-editmode__field-grid--two">
              <label class="tom-map-editmode__field">
                <span>
                  {{tr "Min zoom"}}
                  {{#if systemCritical.minZoom}}
                  <em class="tom-map-editmode__system-critical">({{tr "Attention: System critical"}} - {{tr "System"}}: {{systemCritical.minZoom}})</em>
                  {{/if}}
                </span>
                <input type="number" min="-8" max="24" step="0.1" name="worldMap.minZoom" value="{{map.minZoom}}" />
              </label>
              <label class="tom-map-editmode__field">
                <span>
                  {{tr "Max native zoom"}}
                  {{#if systemCritical.maxNativeZoom}}
                  <em class="tom-map-editmode__system-critical">({{tr "Attention: System critical"}} - {{tr "System"}}: {{systemCritical.maxNativeZoom}})</em>
                  {{/if}}
                </span>
                <input type="number" min="0" max="24" step="1" name="worldMap.maxNativeZoom" value="{{map.maxNativeZoom}}" />
              </label>
              <label class="tom-map-editmode__field">
                <span>{{tr "Max zoom"}}</span>
                <input type="number" min="-8" max="24" step="0.1" name="worldMap.maxZoom" value="{{map.maxZoom}}" />
              </label>
              <label class="tom-map-editmode__field">
                <span>{{tr "Mouse wheel zoom step"}}</span>
                <input type="number" min="0.1" max="2" step="0.05" name="worldMap.zoomStep" value="{{map.zoomStep}}" />
              </label>
            </div>
            <div class="tom-map-editmode__divider"></div>
            <div class="tom-map-editmode__field-grid tom-map-editmode__field-grid--three">
              <label class="tom-map-editmode__field">
                <span>{{tr "Start X"}}</span>
                <input type="number" name="worldMap.initialView.x" value="{{map.initialView.x}}" />
              </label>
              <label class="tom-map-editmode__field">
                <span>{{tr "Start Y"}}</span>
                <input type="number" name="worldMap.initialView.y" value="{{map.initialView.y}}" />
              </label>
              <label class="tom-map-editmode__field">
                <span>{{tr "Start zoom"}}</span>
                <input type="number" min="-8" max="24" step="0.1" name="worldMap.initialView.zoom" value="{{map.initialView.zoom}}" />
              </label>
            </div>
          </section>

          <section class="tom-map-editmode__subcard">
            <header class="tom-map-editmode__subcard-header">
              <span>
                <strong>{{tr "System Paths"}}</strong>
                <small>{{tr "Readonly paths generated by the tile workflow."}}</small>
              </span>
            </header>
            <label class="tom-map-editmode__field">
              <span>{{tr "Tile URL template"}}</span>
              <input type="text" name="worldMap.tileUrlTemplatePreview" value="{{map.tileUrlTemplate}}" readonly />
            </label>
            <label class="tom-map-editmode__field">
              <span>{{tr "Manifest path"}}</span>
              <input type="text" name="worldMap.manifestPathPreview" value="{{map.manifestPath}}" readonly />
            </label>
          </section>
        </div>
      </div>
    </section>
  </div>

  {{#unless inline}}
  <footer class="sheet-footer flexrow">
    <button type="submit" class="tom-map-editmode__generate-button">
      <i class="fas fa-save" aria-hidden="true"></i> {{tr "Save"}}
    </button>
  </footer>
  {{/unless}}
{{#unless inline}}
</form>
{{/unless}}
{{#if inline}}
</div>
{{/if}}
